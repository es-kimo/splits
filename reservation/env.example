# 오라클 인스턴스의 reservation/.env 로 복사해서 채운다. 이 파일에는 실제 값을 적지 않는다.

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=court
MYSQL_USER=court
MYSQL_PASSWORD=

# 총무 토큰 서명에 쓰는 값. 32자 이상의 난수. 바꾸면 모든 총무가 PIN을 다시 넣어야 한다.
ADMIN_TOKEN_SECRET=

# 모임을 처음 만들 때만 채운다. 만든 뒤에는 비워서 엔드포인트를 닫는다.
BOOTSTRAP_SECRET=

# Cloudflare Zero Trust > Tunnels 에서 만든 터널의 토큰
CLOUDFLARE_TUNNEL_TOKEN=
