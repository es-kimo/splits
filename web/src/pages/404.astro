---
import Base from "../layouts/Base.astro";
import { withBase } from "../lib/base";
import { loadMetaDoc } from "../lib/data";

const meta = loadMetaDoc();

const links = [
  { href: withBase(), title: "또래 기록 분포 조회", body: "학년과 거리를 고르고 기록을 넣으면 또래 중 어디쯤인지 바로 볼 수 있어요." },
  { href: withBase("meet/"), title: "대회 찾기", body: "연도와 종목으로 대회를 찾고 종목별 기록 분포를 볼 수 있어요." },
  { href: withBase("athlete/"), title: "공개 선수 기록", body: "공개 중인 선수의 나이별 성적 흐름을 볼 수 있어요." },
  { href: withBase("analysis/"), title: "국가대표 유년기 분석", body: "어릴 때 성적과 이후 경로를 함께 정리해 두었어요." },
];
---

<Base
  title="페이지를 찾을 수 없습니다"
  description="주소가 바뀌었거나 없는 페이지입니다. 분포 조회, 대회, 공개 선수 기록으로 이동할 수 있습니다."
  generatedAt={meta.generatedAt}
  contentWidth="narrow"
  contentLineHeight="compact"
  pageBottomPadding="60px"
  noindex
>
  <header class="card">
    <span class="code">404</span>
    <h1>찾으시는 페이지가 없어요</h1>
    <p class="why">
      주소가 바뀌었거나, 지금은 공개하지 않는 페이지입니다. 대회 주소는 집계 방식이 바뀌면서 변경되기도 합니다.
    </p>
    <p class="what">아래에서 원하시는 곳으로 바로 갈 수 있어요.</p>
  </header>

  <section class="card list">
    {
      links.map((link) => (
        <a class="row" href={link.href}>
          <b>{link.title}</b>
          <span>{link.body}</span>
        </a>
      ))
    }
  </section>

  <p class="site-note">
    공개된 쇼트트랙 경기 결과를 정리해, 또래 기준으로 기록 위치를 확인할 수 있게 만든 페이지입니다.
  </p>

  <style>
    .card {
      background: #ffffff;
      border-radius: 20px;
      padding: 22px 20px 20px;
      margin-bottom: 12px;
    }
    .code {
      display: inline-block;
      font-size: 12px;
      font-weight: 800;
      color: #2e63f6;
      background: #e9f0ff;
      border-radius: 999px;
      padding: 5px 11px;
    }
    h1 {
      margin: 12px 0 0;
      font-size: 27px;
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1.32;
    }
    .why {
      margin: 10px 0 0;
      font-size: 14.5px;
      color: #5b5f68;
    }
    .what {
      margin: 8px 0 0;
      font-size: 14.5px;
      color: #5b5f68;
    }
    .list {
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .row {
      display: block;
      background: #fafbfc;
      border-radius: 16px;
      padding: 14px;
      color: inherit;
    }
    .row b {
      display: block;
      font-size: 15.5px;
      font-weight: 800;
      color: #2e63f6;
    }
    .row span {
      display: block;
      margin-top: 4px;
      font-size: 13.5px;
      color: #6b6f78;
    }
    .site-note {
      margin: 4px 6px 0;
      font-size: 13px;
      color: #9ba0aa;
    }
  </style>
</Base>
