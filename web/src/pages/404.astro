---
import Base from "../layouts/Base.astro";
import { withBase } from "../lib/base";
import { loadMetaDoc } from "../lib/data";

const meta = loadMetaDoc();
---

<Base
  title="페이지를 찾을 수 없어요 — 스플릿"
  description="요청하신 페이지를 찾을 수 없어 메인 화면과 분포 조회로 이동할 수 있는 안내를 제공합니다."
  robots="noindex,follow"
  generatedAt={meta.generatedAt}
>
  <header class="page-head">
    <h1>찾으시는 페이지가 없어요</h1>
    <p class="lead">주소가 바뀌었거나 삭제된 페이지일 수 있어요.</p>
  </header>

  <section class="card">
    <div class="card-head">
      <h2>어디로 이동하면 될까요?</h2>
      <p>스플릿은 국내 쇼트트랙 공개 기록을 또래·선수·대회 기준으로 정리해 보여드려요.</p>
    </div>
    <div class="cta-row">
      <a class="chip is-active" href={withBase()}>메인으로 가기</a>
      <a class="chip" href={withBase("distribution/")}>분포 조회로 가기</a>
    </div>
  </section>

  <style>
    .cta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
  </style>
</Base>
