---
import Trajectory from "../components/Trajectory.astro";
import Base from "../layouts/Base.astro";
import { withBase } from "../lib/base";
import { loadAthletesDoc, loadMetaDoc, loadReverseDistributionDoc } from "../lib/data";

const athletesDoc = loadAthletesDoc();
const reverseDoc = loadReverseDistributionDoc();
const meta = loadMetaDoc();

const ages = athletesDoc.ages;
const athletes = athletesDoc.athletes;

const athleteCount = meta.athleteCount || 0;
const placementCount = `${(meta.placementCount || 0).toLocaleString("ko-KR")}개`;
const yearSpanHead = meta.yearSpan !== null ? `${meta.yearSpan}년치` : "-";
const yearSpanTail = meta.yearStart !== null && meta.yearEnd !== null ? `${meta.yearStart}~${meta.yearEnd}년` : "기간 정보 없음";
const firstAgeText = meta.firstAgeMin !== null && meta.firstAgeMax !== null ? `${meta.firstAgeMin}살부터 ${meta.firstAgeMax}살까지` : "-";

const stageOrder = ["대학·일반 진입", "고등부 완주", "국가대표"];
const distributionSegments = ["상위권", "중위권", "하위권", "초등 기록 없음"];
const typeSegments = ["조기 두각형", "후발 상승형", "늦은 시작형"];

const rows = reverseDoc?.rows ?? [];
const stageLabels = Array.from(new Set([...stageOrder, ...rows.map((row) => row.targetGroup)])).filter((label) => label);

const toNumber = (value: number | null | undefined) => (typeof value === "number" && Number.isFinite(value) ? value : null);
const toPercentText = (value: number | null) => (value === null ? "-" : `${value.toFixed(2)}%`);
const toCountText = (value: number | null) => (value === null ? "-" : `${value.toLocaleString("ko-KR")}명`);
const formatMetricText = (ratio: number | null, count: number | null, total: number | null) =>
  `${toPercentText(ratio)} · ${toCountText(count)} / ${toCountText(total)}`;

const findRow = (targetGroup: string, metric: string, segment: string) =>
  rows.find((row) => row.targetGroup === targetGroup && row.metric === metric && row.segment === segment);

const stageCards = stageLabels
  .map((targetGroup) => {
    const distribution = distributionSegments.map((segment) => {
      const row = findRow(targetGroup, "백분위 분포", segment);
      return {
        segment,
        ratio: toNumber(row?.ratio ?? null),
        count: toNumber(row?.count ?? null),
        targetCount: toNumber(row?.targetCount ?? null),
        nationalCount: toNumber(row?.nationalCount ?? null),
      };
    });
    const typeBreakdown = typeSegments.map((segment) => {
      const row = findRow(targetGroup, "유형 분류", segment);
      return {
        segment,
        ratio: toNumber(row?.ratio ?? null),
        count: toNumber(row?.count ?? null),
        targetCount: toNumber(row?.targetCount ?? null),
        nationalCount: toNumber(row?.nationalCount ?? null),
      };
    });
    const representative = rows.find((row) => row.targetGroup === targetGroup);
    return {
      targetGroup,
      distribution,
      typeBreakdown,
      alignmentIssue7: representative?.alignmentIssue7 ?? "",
      note: representative?.note ?? "",
    };
  })
  .filter((item) => item.distribution.some((row) => row.count !== null || row.ratio !== null) || item.typeBreakdown.some((row) => row.count !== null || row.ratio !== null));

const collegeTop = findRow("대학·일반 진입", "백분위 분포", "상위권");
const collegeNoElem = findRow("대학·일반 진입", "백분위 분포", "초등 기록 없음");
const nationalTop = findRow("국가대표", "백분위 분포", "상위권");

const summaryLines = [
  collegeTop
    ? `대학·일반 진입 집단의 초등 상위권 비율은 ${toPercentText(toNumber(collegeTop.ratio ?? null))}입니다.`
    : "대학·일반 진입 집단의 초등 상위권 비율을 계산할 수 있는 데이터가 없습니다.",
  collegeNoElem
    ? `대학·일반 진입 집단의 초등 기록 없음 비율은 ${toPercentText(toNumber(collegeNoElem.ratio ?? null))}입니다.`
    : "초등 기록 없음 비율을 계산할 수 있는 데이터가 없습니다.",
  nationalTop
    ? `국가대표 14명은 분포 안에서 상위권 비율 ${toPercentText(toNumber(nationalTop.ratio ?? null))}로 관측됩니다.`
    : "국가대표 분포 비교를 계산할 수 있는 데이터가 없습니다.",
];

const missingElemCount = athletes.filter((athlete) => (athlete.elem.count ?? 0) === 0).length;

const ageMin = ages[0] ?? 7;
const ageMid = ages[Math.floor(ages.length / 2)] ?? 12;
const ageMax = ages[ages.length - 1] ?? 18;

const trajectoryCards = athletes
  .map((athlete, index) => {
    const present = ages
      .filter((age) => athlete.ages[String(age)] !== null && athlete.ages[String(age)] !== undefined)
      .map(Number)
      .sort((a, b) => a - b);
    const winCount = present.filter((age) => athlete.ages[String(age)] === 1).length;
    const elemCount = athlete.elem.count ?? 0;
    const median = Number.isFinite(athlete.elem.median) ? athlete.elem.median : null;
    const thin = elemCount > 0 && elemCount < 10;

    const facts: string[] = [];
    if (winCount > 0) facts.push(`1등 ${winCount}번`);
    if (median !== null) facts.push(`초등부 보통 ${median.toFixed(1)}등`);
    if (facts.length === 0) facts.push(`${present.length}개 나이 기록`);

    return {
      alias: `국가대표 사례 ${String(index + 1).padStart(2, "0")}`,
      url: withBase(athlete.url),
      ageRanks: athlete.ages,
      factText: facts.join(" · "),
      thin,
      elemCount,
      sortKey: median ?? 9999,
    };
  })
  .sort((a, b) => a.sortKey - b.sortKey || a.alias.localeCompare(b.alias, "ko"));

const notes = [
  {
    q: "초등 기록 없음은 무엇을 뜻하나요?",
    a: "초등 기록 없음은 늦은 시작과 과거 전산 누락이 함께 섞일 수 있습니다. 따라서 실력 단정으로 해석하면 안 됩니다.",
  },
  {
    q: "분포 기준은 어떻게 계산했나요?",
    a: "초5~6 시기의 결승·채점종합 순위를 기준으로 백분위를 계산했습니다. 같은 학년·성별·거리 안에서만 비교했습니다.",
  },
  {
    q: "고등부 완주와 대학·일반 진입은 어떻게 나눴나요?",
    a: "고등부 완주는 고등 단계 도달 후 대학 단계로 넘어가지 않은 집단, 대학·일반 진입은 대학 단계 이상에 도달한 집단으로 분리했습니다.",
  },
  {
    q: "왜 여기서는 실명을 숨겼나요?",
    a: "이 페이지는 분포 해석 중심 화면이라 실명 대신 사례 번호를 사용합니다. 기존 선수 상세 페이지 이동 기능은 그대로 유지됩니다.",
  },
  {
    q: "이 자료로 무엇을 알 수 있나요?",
    a: "상위 단계 도달 집단의 유년기 분포 패턴은 볼 수 있지만, 특정 개인의 미래 성과를 보장하는 인과 결론은 만들 수 없습니다.",
  },
];
---

<Base
  title="상위 단계 도달자의 유년기 분포 — 스플릿"
  description="대학·일반 진입자, 고등부 완주자, 국가대표 사례의 초5~6 백분위 분포를 비교해 보여주는 페이지입니다."
  ogTitle="상위 단계 도달자의 유년기 분포"
  ogImage="og-default.png"
  generatedAt={meta.generatedAt}
>
  <header class="page-head">
    <span class="eyebrow">공개 경기 기록 정리</span>
    <h1>상위 단계 도달자의 유년기 분포</h1>
    <p class="lead">대학·일반 진입, 고등부 완주, 국가대표 사례를 같은 기준으로 나란히 비교해요.</p>
  </header>

  <section class="card">
    <div class="card-head">
      <h2>먼저, 한 줄 결론</h2>
    </div>
    <div class="summary-list">
      {
        summaryLines.map((line, index) => (
          <div class="summary-item">
            <span class="summary-index">{index + 1}</span>
            <p class="summary-text">{line}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="card">
    <div class="metric-grid is-4">
      <div class="metric"><b>{athleteCount}명</b><span>국가대표 사례 수</span></div>
      <div class="metric"><b>{placementCount}</b><span>모은 경기 성적</span></div>
      <div class="metric"><b>{firstAgeText}</b><span>처음 대회 출전 나이 범위</span></div>
      <div class="metric"><b>{yearSpanHead}</b><span>{yearSpanTail}</span></div>
    </div>
  </section>

  <section class="card">
    <div class="card-head">
      <h2>도달 단계별 분포</h2>
      <p>상위권·중위권·하위권·초등 기록 없음 비율을 같은 축으로 비교합니다.</p>
    </div>
    {
      stageCards.length === 0 ? (
        <p class="hint">표시할 분포 데이터가 없어요.</p>
      ) : (
        <div class="stage-grid">
          {
            stageCards.map((card) => (
              <article class="tile stage-card">
                <h3>{card.targetGroup}</h3>
                <div class="stage-block">
                  <div class="stage-title">초등 백분위 분포</div>
                  <div class="bar-list">
                    {
                      card.distribution.map((row) => (
                        <div class="bar-row">
                          <div class="bar-label">{row.segment}</div>
                          <div class="bar-track">
                            <span class="bar-fill" style={`width:${Math.max(0, Math.min(100, row.ratio ?? 0))}%`}></span>
                          </div>
                          <div class="bar-value">{formatMetricText(row.ratio, row.count, row.targetCount)}</div>
                          {card.targetGroup !== "국가대표" && (row.nationalCount ?? 0) > 0 && <div class="bar-sub">국가대표 {row.nationalCount}명 포함</div>}
                        </div>
                      ))
                    }
                  </div>
                </div>
                <div class="stage-block">
                  <div class="stage-title">유형 비율</div>
                  <div class="bar-list">
                    {
                      card.typeBreakdown.map((row) => (
                        <div class="bar-row">
                          <div class="bar-label">{row.segment}</div>
                          <div class="bar-track">
                            <span class="bar-fill is-type" style={`width:${Math.max(0, Math.min(100, row.ratio ?? 0))}%`}></span>
                          </div>
                          <div class="bar-value">{formatMetricText(row.ratio, row.count, row.targetCount)}</div>
                          {card.targetGroup !== "국가대표" && (row.nationalCount ?? 0) > 0 && <div class="bar-sub">국가대표 {row.nationalCount}명 포함</div>}
                        </div>
                      ))
                    }
                  </div>
                </div>
                {card.alignmentIssue7 === "N" && <div class="note-box">7번 결과와 방향이 달라 해석을 보류합니다.</div>}
                {card.note && <p class="hint">{card.note}</p>}
              </article>
            ))
          }
        </div>
      )
    }
  </section>

  <section class="card">
    <div class="card-head">
      <h2>국가대표 14명 사례 보기</h2>
      <p>실명 대신 사례 번호로 표시합니다. 카드를 누르면 기존 상세 기록 페이지로 이동해요.</p>
    </div>
    <div class="age-cards">
      {
        trajectoryCards.map((card) => (
          <article class="tile age-card">
            <div class="age-head">
              <b class="age-name"><a href={card.url}>{card.alias}</a></b>
              <span class="age-birth">상세 기록 보기</span>
            </div>
            <div class={`age-fact ${card.thin ? "is-thin" : ""}`}>
              {card.factText}
              {card.thin && <span class="age-thin-mark">출전 {card.elemCount}번</span>}
            </div>
            <Trajectory ages={ages} ageRanks={card.ageRanks} />
            <div class="age-axis">
              <span>{ageMin}살</span><span>{ageMid}살</span><span>{ageMax}살</span>
            </div>
          </article>
        ))
      }
    </div>
    <div class="note-box">
      초등 기록이 없는 국가대표 사례는 {missingElemCount}명입니다. 이는 늦은 시작과 전산 누락이 함께 섞일 수 있으므로
      실력 결론으로 단정하면 안 됩니다.
    </div>
  </section>

  <section class="card">
    <div class="card-head">
      <h2>이 자료를 볼 때 알아두실 점</h2>
      <p>숫자를 오해하지 않으시도록, 계산 기준과 한계를 먼저 적어둡니다.</p>
    </div>
    <div class="qa-list">
      {
        notes.map((note) => (
          <div class="qa">
            <div class="qa-q">{note.q}</div>
            <div class="qa-a">{note.a}</div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="card">
    <div class="card-head">
      <h2>이어서 볼 만한 페이지</h2>
    </div>
    <div class="list">
      <a class="row-link link-card" href={withBase()}>
        <b>우리 아이 기록은 어디쯤일까요</b>
        <span>또래와 견줘서 상위 몇 %인지 확인해요.</span>
      </a>
      <a class="row-link link-card" href={withBase("athlete/")}>
        <b>전체 선수 목록</b>
        <span>선수별 상세 기록 페이지로 이동해요.</span>
      </a>
      <a class="row-link link-card" href={withBase("meet/")}>
        <b>대회 목록</b>
        <span>대회별 경기 수와 참가 선수를 볼 수 있어요.</span>
      </a>
    </div>
  </section>

  <style>
    .summary-list {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .summary-item {
      display: flex;
      gap: 12px;
      align-items: flex-start;
    }
    .summary-index {
      flex: none;
      width: 26px;
      height: 26px;
      border-radius: 9px;
      background: var(--point-bg-2);
      color: var(--point);
      font-size: 13px;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .summary-text {
      margin: 0;
      font-size: 15.5px;
      color: var(--text);
    }
    .stage-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 10px;
    }
    .stage-card {
      padding: 14px;
    }
    .stage-card h3 {
      margin: 0 0 10px;
      font-size: 17px;
      letter-spacing: -0.01em;
    }
    .stage-block + .stage-block {
      margin-top: 14px;
    }
    .stage-title {
      font-size: 13px;
      font-weight: 700;
      color: var(--sub);
      margin-bottom: 8px;
    }
    .bar-list {
      display: flex;
      flex-direction: column;
      gap: 7px;
    }
    .bar-row {
      display: grid;
      grid-template-columns: 84px 1fr;
      gap: 8px 10px;
      align-items: center;
    }
    .bar-label {
      font-size: 12.5px;
      color: var(--sub);
      font-weight: 600;
    }
    .bar-track {
      height: 9px;
      border-radius: 99px;
      background: var(--surface-3);
      overflow: hidden;
      position: relative;
    }
    .bar-fill {
      display: block;
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(90deg, #3b82f6 0%, #2563eb 100%);
    }
    .bar-fill.is-type {
      background: linear-gradient(90deg, #14b8a6 0%, #0d9488 100%);
    }
    .bar-value {
      grid-column: 2 / -1;
      font-size: 12.5px;
      color: var(--sub-2);
      margin-top: -3px;
    }
    .bar-sub {
      grid-column: 2 / -1;
      font-size: 12px;
      color: var(--point);
      margin-top: -6px;
    }
    .age-cards {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
      gap: 8px;
    }
    .age-card {
      padding: 14px 14px 10px;
    }
    .age-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 8px;
    }
    .age-name {
      font-size: 16px;
      font-weight: 700;
      letter-spacing: -0.01em;
    }
    .age-name a {
      color: inherit;
    }
    .age-name a:hover {
      color: var(--point);
    }
    .age-birth {
      flex: none;
      font-size: 12.5px;
      color: var(--faint);
    }
    .age-fact {
      display: flex;
      align-items: center;
      gap: 6px;
      margin: 3px 0 4px;
      font-size: 12.5px;
      font-weight: 600;
      color: var(--point);
      font-variant-numeric: tabular-nums;
    }
    .age-fact.is-thin {
      color: var(--faint);
    }
    .age-thin-mark {
      font-weight: 500;
      color: var(--faint-2);
    }
    .age-axis {
      display: flex;
      justify-content: space-between;
      font-size: 11.5px;
      color: var(--faint-2);
      padding: 0 2px;
    }
    .link-card {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }
    .link-card b {
      font-size: 15px;
      font-weight: 700;
      letter-spacing: -0.01em;
    }
    .link-card span {
      font-size: 13.5px;
      color: var(--sub-2);
    }
  </style>
</Base>
