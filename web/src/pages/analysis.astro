---
import Trajectory from "../components/Trajectory.astro";
import Base from "../layouts/Base.astro";
import { withBase } from "../lib/base";
import { loadAthletesDoc, loadMetaDoc } from "../lib/data";

const athletesDoc = loadAthletesDoc();
const meta = loadMetaDoc();

const ages = athletesDoc.ages;
const athletes = athletesDoc.athletes;

const athleteCount = meta.athleteCount || 0;
const placementCount = `${(meta.placementCount || 0).toLocaleString("ko-KR")}개`;
const ageSpan = meta.ageMin !== null && meta.ageMax !== null ? `${meta.ageMin}~${meta.ageMax}살` : "-";
const yearSpanHead = meta.yearSpan !== null ? `${meta.yearSpan}년치` : "-";
const yearSpanTail = meta.yearStart !== null && meta.yearEnd !== null ? `${meta.yearStart}~${meta.yearEnd}년` : "기간 정보 없음";
const firstAgeText = meta.firstAgeMin !== null && meta.firstAgeMax !== null ? `${meta.firstAgeMin}살부터 ${meta.firstAgeMax}살까지` : "-";

const summaryLines = [
  `초등부 기록이 남아 있는 ${meta.elemTop2Count || 0}명 모두, 초등학생 때 이미 최소 한 번은 1~2등을 했어요.`,
  `그렇다고 늘 앞자리였던 건 아니에요. 같은 선수들의 초등부 성적 중에는 ${meta.elemWorstBand || "-"}도 섞여 있어요.`,
  `처음 대회에 나온 나이는 ${firstAgeText} 제각각이었어요.`,
];

const byName = new Map(athletes.map((athlete) => [athlete.name, athlete]));
const missingNames = meta.missingElemNames.map((name) => {
  const athlete = byName.get(name);
  if (!athlete || athlete.birth === null) return name;
  return `${name}(${athlete.birth}년생)`;
});
const missingElemNote =
  missingNames.length === 0
    ? ""
    : `${missingNames.join(", ")}은 초등부 기록이 남아 있지 않아 빠졌어요. 대회에 안 나갔다는 뜻은 아니에요.`;
const missingLimitNote = missingNames.length === 0 ? "" : ` ${missingNames.join(", ")}이 여기에 해당해요.`;

const ageMin = ages[0] ?? 7;
const ageMid = ages[Math.floor(ages.length / 2)] ?? 12;
const ageMax = ages[ages.length - 1] ?? 18;

// 궤적 카드 하나에 '몇 살 기록이 있는지 · 1등 횟수 · 초등부에 보통 받던 등수'를 함께 담는다.
const trajectoryCards = athletes
  .map((athlete) => {
    const present = ages
      .filter((age) => athlete.ages[String(age)] !== null && athlete.ages[String(age)] !== undefined)
      .map(Number)
      .sort((a, b) => a - b);
    const winCount = present.filter((age) => athlete.ages[String(age)] === 1).length;
    const elemCount = athlete.elem.count ?? 0;
    const median = Number.isFinite(athlete.elem.median) ? athlete.elem.median : null;
    const thin = elemCount > 0 && elemCount < 10;

    const facts: string[] = [];
    if (winCount > 0) facts.push(`1등 ${winCount}번`);
    if (median !== null) facts.push(`초등부 보통 ${median.toFixed(1)}등`);
    if (facts.length === 0) facts.push(`${present.length}개 나이 기록`);

    return {
      name: athlete.name,
      url: withBase(athlete.url),
      birth: athlete.birth,
      ageRanks: athlete.ages,
      factText: facts.join(" · "),
      thin,
      elemCount,
      sortKey: median ?? 9999,
    };
  })
  .sort((a, b) => a.sortKey - b.sortKey || a.name.localeCompare(b.name, "ko"));

const notes = [
  {
    q: "나이는 어떻게 계산했나요?",
    a: "대회가 열린 해에서 태어난 해를 뺐어요. 생일이 지나지 않았다면 만 나이보다 한 살 많아요. 겨울 대회가 1~2월에 몰려 있어서, 대체로 한 살 높게 잡혀 있다고 보시면 돼요.",
  },
  {
    q: "왜 옛날 선수는 어릴 때 기록이 없나요?",
    a: `2012년 이전 대회는 일부만 전산화돼 있어요. 1990년대 중반 이전에 태어난 선수는 유년기 기록이 통째로 비어 있습니다.${missingLimitNote}`,
  },
  {
    q: "어떤 경기의 등수인가요?",
    a: "결승과 채점종합 기준이에요. 예선이나 준결승처럼 조 안에서 매긴 등수는 전체 성적이 아니라서 뺐어요.",
  },
  {
    q: "기록(시간)은 왜 없나요?",
    a: "쇼트트랙은 순위 경기예요. 결승에서 일부러 천천히 타다 마지막에 붙는 경우가 많아서, 예선보다 30초 넘게 느린데 1등인 기록도 있어요. 시간이 실력을 그대로 보여주지 않아 싣지 않았습니다.",
  },
  {
    q: "잘못된 기록은 없나요?",
    a: "계측 오류로 보이는 기록 35건을 확인했지만, 임의로 고치지 않고 원본 그대로 두었어요.",
  },
  {
    q: "이 자료로 무엇을 알 수 있나요?",
    a: "국가대표 14명이 어릴 때 어떤 성적을 남겼는지까지예요. 앞으로 누가 국가대표가 될지는 이 자료로 알 수 없어요.",
  },
];
---

<Base
  title={`국가대표 ${athleteCount}명의 유년기 기록`}
  description="쇼트트랙 국가대표 선수들의 유년기 순위 데이터를 정리한 페이지입니다. 선수별 상세 페이지에서 나이별 성적과 전체 대회 이력을 볼 수 있습니다."
  ogTitle={`국가대표 ${athleteCount}명의 유년기 기록`}
  ogImage="og-default.png"
  generatedAt={meta.generatedAt}
>
  <header class="page-head">
    <span class="eyebrow">공개 경기 기록 정리</span>
    <h1>쇼트트랙 국가대표 {athleteCount}명은<br />어릴 때 몇 등이었을까요?</h1>
    <p class="lead">
      2026/27시즌 국가대표 {athleteCount}명이 <b>7살 때부터</b> 국내 대회에서 받은 성적을 모았어요.
    </p>
  </header>

  <section class="card">
    <div class="card-head">
      <h2>먼저, 세 줄 요약</h2>
    </div>
    <div class="summary-list">
      {
        summaryLines.map((line, index) => (
          <div class="summary-item">
            <span class="summary-index">{index + 1}</span>
            <p class="summary-text">{line}</p>
          </div>
        ))
      }
    </div>
    <div class="note-box">
      어릴 때 1등이면 국가대표가 된다는 뜻은 아니에요. 국가대표가 되지 못한 수많은 선수의 기록은 여기에 없기 때문입니다.
    </div>
  </section>

  <section class="card">
    <div class="metric-grid is-4">
      <div class="metric"><b>{athleteCount}명</b><span>국가대표 선수</span></div>
      <div class="metric"><b>{placementCount}</b><span>모은 경기 성적</span></div>
      <div class="metric"><b>{ageSpan}</b><span>기록에 담긴 나이</span></div>
      <div class="metric"><b>{yearSpanHead}</b><span>{yearSpanTail}</span></div>
    </div>
  </section>

  <section class="card">
    <div class="card-head">
      <h2>한 명씩, 어릴 때 성적</h2>
      <p>나이별로 <b>가장 잘했던 등수</b>를 찍었어요. 초등부 성적이 좋았던 순서로 놓았습니다.</p>
    </div>
    <div class="read-box">
      <div class="read-title">이렇게 보세요</div>
      <div class="read-row"><span class="dot-blue"></span>파란 점이 위에 붙을수록 1등에 가까워요</div>
      <div class="read-row"><span class="dot-gray"></span>회색 점은 등수가 뒤로 밀린 해예요 (옆에 등수 표시)</div>
      <div class="read-row"><span class="line-gray"></span>아래쪽 짧은 선은 그 나이의 기록이 아예 없다는 뜻이에요</div>
    </div>
    <div class="age-cards">
      {
        trajectoryCards.map((card) => (
          <article class="tile age-card">
            <div class="age-head">
              <b class="age-name"><a href={card.url}>{card.name}</a></b>
              <span class="age-birth">{card.birth !== null ? `${card.birth}년생` : "출생년도 미상"}</span>
            </div>
            <div class={`age-fact ${card.thin ? "is-thin" : ""}`}>
              {card.factText}
              {card.thin && <span class="age-thin-mark">출전 {card.elemCount}번</span>}
            </div>
            <Trajectory ages={ages} ageRanks={card.ageRanks} />
            <div class="age-axis">
              <span>{ageMin}살</span><span>{ageMid}살</span><span>{ageMax}살</span>
            </div>
          </article>
        ))
      }
    </div>
    <div class="note-box">
      비어 있는 구간은 성적이 나빴다는 뜻이 아니라, 그 나이의 기록이 시스템에 없다는 뜻이에요. 초등부 출전이 10번이 안 되는
      선수는 '보통 등수'를 회색으로 적었어요. 몇 경기 안 되는 성적이라 그대로 믿기는 어렵거든요.
      {missingElemNote && ` ${missingElemNote}`}
    </div>
  </section>

  <section class="card">
    <div class="card-head">
      <h2>이 자료를 볼 때 알아두실 점</h2>
      <p>숫자를 오해하지 않으시도록, 데이터의 한계를 먼저 적어둘게요.</p>
    </div>
    <div class="qa-list">
      {
        notes.map((note) => (
          <div class="qa">
            <div class="qa-q">{note.q}</div>
            <div class="qa-a">{note.a}</div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="card">
    <div class="card-head">
      <h2>이어서 볼 만한 페이지</h2>
    </div>
    <div class="list">
      <a class="row-link link-card" href={withBase()}>
        <b>우리 아이 기록은 어디쯤일까요</b>
        <span>또래와 견줘서 상위 몇 %인지 확인해요.</span>
      </a>
      <a class="row-link link-card" href={withBase("athlete/")}>
        <b>전체 선수 목록</b>
        <span>선수별 상세 기록 페이지로 이동해요.</span>
      </a>
      <a class="row-link link-card" href={withBase("meet/")}>
        <b>대회 목록</b>
        <span>대회별 경기 수와 참가 선수를 볼 수 있어요.</span>
      </a>
    </div>
  </section>

  <style>
    .summary-list {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .summary-item {
      display: flex;
      gap: 12px;
      align-items: flex-start;
    }
    .summary-index {
      flex: none;
      width: 26px;
      height: 26px;
      border-radius: 9px;
      background: var(--point-bg-2);
      color: var(--point);
      font-size: 13px;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .summary-text {
      margin: 0;
      font-size: 15.5px;
      color: var(--text);
    }
    .read-box {
      background: var(--surface-3);
      border-radius: var(--r-inner);
      padding: 14px 16px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 14px;
    }
    .read-title {
      font-size: 13.5px;
      font-weight: 700;
      color: var(--text);
    }
    .read-row {
      display: flex;
      align-items: center;
      gap: 9px;
      font-size: 13.5px;
      color: var(--sub-2);
    }
    .dot-blue,
    .dot-gray {
      flex: none;
      width: 11px;
      height: 11px;
      border-radius: 50%;
    }
    .dot-blue {
      background: var(--point);
    }
    .dot-gray {
      background: var(--faint-2);
    }
    .line-gray {
      flex: none;
      width: 11px;
      height: 3px;
      border-radius: 2px;
      background: #dfe3e9;
    }
    .age-cards {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
      gap: 8px;
    }
    .age-card {
      padding: 14px 14px 10px;
    }
    .age-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 8px;
    }
    .age-name {
      font-size: 16px;
      font-weight: 700;
      letter-spacing: -0.01em;
    }
    .age-name a {
      color: inherit;
    }
    .age-name a:hover {
      color: var(--point);
    }
    .age-birth {
      flex: none;
      font-size: 12.5px;
      color: var(--faint);
    }
    .age-fact {
      display: flex;
      align-items: center;
      gap: 6px;
      margin: 3px 0 4px;
      font-size: 12.5px;
      font-weight: 600;
      color: var(--point);
      font-variant-numeric: tabular-nums;
    }
    .age-fact.is-thin {
      color: var(--faint);
    }
    .age-thin-mark {
      font-weight: 500;
      color: var(--faint-2);
    }
    .age-axis {
      display: flex;
      justify-content: space-between;
      font-size: 11.5px;
      color: var(--faint-2);
      padding: 0 2px;
    }
    .link-card {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }
    .link-card b {
      font-size: 15px;
      font-weight: 700;
      letter-spacing: -0.01em;
    }
    .link-card span {
      font-size: 13.5px;
      color: var(--sub-2);
    }
  </style>
</Base>
