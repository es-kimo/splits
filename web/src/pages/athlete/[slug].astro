---
import Trajectory from "../../components/Trajectory.astro";
import Base from "../../layouts/Base.astro";
import { withBase } from "../../lib/base";
import { loadAthletesDoc, loadMetaDoc } from "../../lib/data";
import type { Athlete, AthleteHistoryItem } from "../../lib/types";

export function getStaticPaths() {
  const { athletes } = loadAthletesDoc();
  return athletes.map((athlete) => ({
    params: { slug: athlete.slug },
    props: { athlete },
  }));
}

const { athlete } = Astro.props as { athlete: Athlete };
const { ages } = loadAthletesDoc();
const meta = loadMetaDoc();

const totalRaces = athlete.history.length;
const goldCount = athlete.history.filter((item) => item.rank === 1 && !item.sf).length;
const years = athlete.history.map((item) => item.year).filter((year): year is number => year !== null);
const minYear = years.length > 0 ? Math.min(...years) : null;
const maxYear = years.length > 0 ? Math.max(...years) : null;
const seasonSpan = minYear !== null && maxYear !== null ? `${maxYear - minYear + 1}년` : "-";
const yearRange = minYear !== null && maxYear !== null ? `${minYear}~${maxYear}년` : "기간 정보 없음";
const subtitle = `${athlete.birth ?? "출생년도 미상"}${athlete.birth ? "년생" : ""} · ${athlete.team}${athlete.gender ? ` · ${athlete.gender}` : ""}`;
const ageMin = ages[0] ?? 7;
const ageMid = ages[Math.floor(ages.length / 2)] ?? 12;
const ageMax = ages[ages.length - 1] ?? 18;
const birthText = athlete.birth !== null ? `${athlete.birth}년생` : "출생연도 미상";
const pageTitle = `${athlete.name} 경기 기록 — 스플릿`;
const pageDescription = `${athlete.name}(${birthText}, ${athlete.team}) 쇼트트랙 경기 기록`;
const canonicalUrl = `athlete/${athlete.slug}/`;
const ogTitle = `${athlete.name} 경기 기록`;

const missingNote =
  athlete.birth !== null && minYear !== null
    ? `${minYear - athlete.birth}살(${minYear}년) 이전 기록은 시스템에 남아 있지 않아요. 대회에 나가지 않았다는 뜻은 아니에요.`
    : "초기 시즌 기록은 시스템에 남아 있지 않아요. 대회에 나가지 않았다는 뜻은 아니에요.";

const bestRank = athlete.history.reduce<number | null>((best, item) => {
  if (item.sf || item.rank === null) return best;
  return best === null || item.rank < best ? item.rank : best;
}, null);
const bestYear =
  bestRank === null
    ? null
    : athlete.history.find((item) => !item.sf && item.rank === bestRank)?.year ?? null;

function normalizeGroupLabel(text: string): "종합" | "A" | "B" {
  const value = String(text || "").trim();
  if (value.includes("종합")) return "종합";
  if (value === "B" || value.includes("결승B") || value.startsWith("B")) return "B";
  return "A";
}

interface GroupedMeet {
  name: string;
  meetUrl: string | null;
  results: AthleteHistoryItem[];
}

interface GroupedYear {
  year: number;
  age: number | null;
  meets: GroupedMeet[];
}

const groupedYears = new Map<number, GroupedYear>();
for (const item of athlete.history) {
  if (item.year === null) continue;
  const yearBucket = groupedYears.get(item.year) ?? { year: item.year, age: item.age, meets: [] };
  const meetName = item.meet || "-";
  let meetBucket = yearBucket.meets.find((meet) => meet.name === meetName);
  if (!meetBucket) {
    meetBucket = { name: meetName, meetUrl: item.meetUrl, results: [] };
    yearBucket.meets.push(meetBucket);
  }
  if (!meetBucket.meetUrl && item.meetUrl) {
    meetBucket.meetUrl = item.meetUrl;
  }
  meetBucket.results.push(item);
  groupedYears.set(item.year, yearBucket);
}
const yearCards = [...groupedYears.values()]
  .sort((a, b) => b.year - a.year)
  .map((yearGroup) => ({
    ...yearGroup,
    meets: yearGroup.meets.map((meet) => ({
      ...meet,
      results: meet.results.slice().sort((a, b) => {
        const distanceA = a.distance ?? 9999;
        const distanceB = b.distance ?? 9999;
        const semiA = a.sf ? 1 : 0;
        const semiB = b.sf ? 1 : 0;
        return distanceA - distanceB || semiA - semiB || a.rank - b.rank;
      }),
    })),
  }));

const glossary = [
  { term: "A그룹", body: "상위 선수들이 겨루는 결승이에요. 같은 등수라도 A그룹이 더 높은 순위입니다." },
  { term: "B그룹", body: "A그룹에 들지 못한 선수들의 결승이에요." },
  { term: "종합", body: "전국동계체육대회처럼 그룹을 나누지 않고 매긴 순위예요." },
  { term: "준결승", body: "결승 전 단계예요. 조 안에서 매긴 등수라 전체 순위와 다릅니다." },
];
---

<Base
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  ogTitle={ogTitle}
  ogImage="og-player.png"
  generatedAt={meta.generatedAt}
  back={{ href: withBase("athlete/"), label: "공개 선수 목록" }}
>
  <header class="page-head is-tight">
    <h1>{athlete.name}</h1>
    <p class="lead">{subtitle}</p>
  </header>

  <section class="card">
    <div class="metric-grid">
      <div class="metric"><b>{totalRaces}회</b><span>전체 경기</span></div>
      <div class="metric is-point"><b>{goldCount}회</b><span>1등</span></div>
      <div class="metric"><b>{seasonSpan}</b><span>{yearRange}</span></div>
    </div>
  </section>

  <section class="card">
    <div class="card-head">
      <h2>어릴 때부터 지금까지</h2>
      <p>나이마다 <b>가장 잘했던 등수</b>를 찍었어요. 파란 점이 위에 붙을수록 1등에 가까워요.</p>
    </div>
    <div class="tile">
      <Trajectory ages={ages} ageRanks={athlete.ages} />
      <div class="age-axis">
        <span>{ageMin}살</span><span>{ageMid}살</span><span>{ageMax}살</span>
      </div>
    </div>
    {
      bestRank !== null && (
        <p class="best-line">
          가장 좋았던 성적은 <b>{bestRank}등</b>
          {bestYear !== null && `, ${bestYear}년`}
          {bestYear !== null && athlete.birth !== null && ` (${bestYear - athlete.birth}살)`}이에요.
        </p>
      )
    }
    <p class="hint">
      비어 있는 구간은 성적이 나빴다는 뜻이 아니라, 그 나이의 기록이 시스템에 없다는 뜻이에요. {missingNote}
    </p>
  </section>

  <section class="card">
    <div class="card-head">
      <h2>전체 대회 기록</h2>
      <p>대회 하나가 카드 하나예요. 종목별 등수는 오른쪽에 나와요.</p>
    </div>
    <div class="year-groups">
      {
        yearCards.map((yearGroup) => (
          <article class="year-group">
            <div class="year-group-head">
              <b>{yearGroup.year}년</b>
              <span>
                {athlete.birth !== null ? `${yearGroup.year - athlete.birth}살 · ` : ""}
                {yearGroup.meets.reduce((acc, meet) => acc + meet.results.length, 0)}경기
              </span>
            </div>
            <div class="list">
              {yearGroup.meets.map((meet) => (
                <div class="tile meet-card">
                  <b class="meet-name">{meet.meetUrl ? <a href={withBase(meet.meetUrl)}>{meet.name}</a> : meet.name}</b>
                  <div class="results">
                    {meet.results.map((result) => {
                      const groupLabel = normalizeGroupLabel(result.round);
                      const note = result.sf ? "준결승" : groupLabel === "종합" ? "종합 순위" : `${groupLabel}그룹 결승`;
                      let tone = "";
                      if (result.sf) tone = "is-mute";
                      else if (result.rank === 1) tone = "is-gold";
                      else if (result.rank === 2 || result.rank === 3) tone = "is-podium";
                      return (
                        <div class="result-row">
                          <span class="distance">{result.distance ?? "-"}m</span>
                          <span class="round-note">{note}</span>
                          <span class={`rank-badge ${tone}`}>{result.rank}등</span>
                        </div>
                      );
                    })}
                  </div>
                </div>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="card">
    <div class="card-head">
      <h2>이 말은 무슨 뜻인가요?</h2>
      <p>기록에 나오는 표기를 풀어서 적어둘게요.</p>
    </div>
    <div class="glossary">
      {
        glossary.map((entry) => (
          <div class="glossary-row">
            <span class="badge glossary-term">{entry.term}</span>
            <p>{entry.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="card">
    <div class="card-head">
      <h2>기록을 내려달라고 요청할 수 있나요?</h2>
      <p>선수 정보의 열람·정정·삭제·처리정지를 요청하실 수 있어요.</p>
    </div>
    <div class="tile request-tile">
      <span>요청 접수 메일(예시): privacy@example.com</span>
      <a class="chip request-link" href={withBase("privacy/#request")}>요청 안내 보기</a>
    </div>
  </section>

  <style>
    .age-axis {
      margin-top: 6px;
      display: flex;
      justify-content: space-between;
      font-size: 11.5px;
      color: var(--faint-2);
      padding: 0 4px;
    }
    .best-line {
      margin: 12px 0 0;
      font-size: 14.5px;
      color: var(--sub);
    }
    .best-line b {
      color: var(--point);
      font-weight: 700;
    }
    .year-groups {
      display: flex;
      flex-direction: column;
      gap: var(--gap-section);
    }
    .year-group-head {
      padding: 0 2px 10px;
      display: flex;
      align-items: baseline;
      gap: 8px;
    }
    .year-group-head b {
      font-size: 17px;
      font-weight: 800;
      letter-spacing: -0.02em;
      font-variant-numeric: tabular-nums;
    }
    .year-group-head span {
      font-size: 13px;
      color: var(--faint);
    }
    .meet-card {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .meet-name {
      font-size: 15px;
      font-weight: 700;
      line-height: 1.4;
      letter-spacing: -0.01em;
    }
    .meet-name a {
      color: inherit;
      text-decoration: underline;
      text-decoration-color: #d3d8e0;
      text-underline-offset: 2px;
    }
    .results {
      display: flex;
      flex-direction: column;
    }
    .result-row {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 7px 2px;
      border-top: 1px solid var(--line);
    }
    .distance {
      flex: none;
      width: 62px;
      font-size: 14.5px;
      font-weight: 600;
      color: var(--text);
      font-variant-numeric: tabular-nums;
    }
    .round-note {
      font-size: 12.5px;
      color: var(--faint-2);
    }
    .result-row .rank-badge {
      margin-left: auto;
    }
    .glossary {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .glossary-row {
      display: flex;
      gap: 10px;
      align-items: flex-start;
    }
    .glossary-term {
      min-width: 50px;
      text-align: center;
      font-size: 12px;
      color: var(--sub);
      padding: 5px 8px;
    }
    .glossary-row p {
      margin: 0;
      font-size: 14px;
      color: var(--sub);
    }
    .request-tile {
      background: var(--surface-3);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      flex-wrap: wrap;
    }
    .request-tile > span {
      font-size: 13.5px;
      color: var(--sub);
    }
    .request-link {
      background: var(--surface);
      color: var(--point);
      font-weight: 700;
      min-height: 40px;
    }
    .request-link:hover {
      color: var(--point-hover);
    }
  </style>
</Base>
