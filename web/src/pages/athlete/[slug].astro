---
import Base from "../../layouts/Base.astro";
import { withBase } from "../../lib/base";
import { loadAthletesDoc, loadMetaDoc } from "../../lib/data";
import type { Athlete, AthleteHistoryItem } from "../../lib/types";

export function getStaticPaths() {
  const { athletes } = loadAthletesDoc();
  return athletes.map((athlete) => ({
    params: { slug: athlete.slug },
    props: { athlete },
  }));
}

const { athlete } = Astro.props as { athlete: Athlete };
const meta = loadMetaDoc();

const totalRaces = athlete.history.length;
const goldCount = athlete.history.filter((item) => item.rank === 1 && !item.sf).length;
const years = athlete.history.map((item) => item.year).filter((year): year is number => year !== null);
const minYear = years.length > 0 ? Math.min(...years) : null;
const maxYear = years.length > 0 ? Math.max(...years) : null;
const seasonSpan = minYear !== null && maxYear !== null ? `${maxYear - minYear + 1}년` : "-";
const yearRange = minYear !== null && maxYear !== null ? `${minYear}~${maxYear}년` : "기간 정보 없음";
const subtitle = `${athlete.birth ?? "출생년도 미상"}${athlete.birth ? "년생" : ""} · ${athlete.team}${athlete.gender ? ` · ${athlete.gender}` : ""}`;

const missingNote =
  athlete.birth !== null && minYear !== null
    ? `${minYear - athlete.birth}살(${minYear}년) 이전 기록은 시스템에 남아 있지 않습니다. 대회에 나가지 않았다는 뜻은 아닙니다.`
    : "초기 시즌 기록은 시스템에 남아 있지 않습니다. 대회에 나가지 않았다는 뜻은 아닙니다.";

const yearBest = new Map<number, number>();
for (const item of athlete.history) {
  if (item.sf || item.year === null || item.rank === null) continue;
  const current = yearBest.get(item.year);
  if (current === undefined || item.rank < current) {
    yearBest.set(item.year, item.rank);
  }
}
const yearBestRows = [...yearBest.entries()].sort((a, b) => b[0] - a[0]);

function normalizeGroupLabel(text: string): "종합" | "A" | "B" {
  const value = String(text || "").trim();
  if (value.includes("종합")) return "종합";
  if (value === "B" || value.includes("결승B") || value.startsWith("B")) return "B";
  return "A";
}

interface GroupedMeet {
  name: string;
  results: AthleteHistoryItem[];
}

interface GroupedYear {
  year: number;
  age: number | null;
  meets: GroupedMeet[];
}

const groupedYears = new Map<number, GroupedYear>();
for (const item of athlete.history) {
  if (item.year === null) continue;
  const yearBucket = groupedYears.get(item.year) ?? { year: item.year, age: item.age, meets: [] };
  const meetName = item.meet || "-";
  let meetBucket = yearBucket.meets.find((meet) => meet.name === meetName);
  if (!meetBucket) {
    meetBucket = { name: meetName, results: [] };
    yearBucket.meets.push(meetBucket);
  }
  meetBucket.results.push(item);
  groupedYears.set(item.year, yearBucket);
}
const yearCards = [...groupedYears.values()]
  .sort((a, b) => b.year - a.year)
  .map((yearGroup) => ({
    ...yearGroup,
    meets: yearGroup.meets.map((meet) => ({
      ...meet,
      results: meet.results.slice().sort((a, b) => {
        const distanceA = a.distance ?? 9999;
        const distanceB = b.distance ?? 9999;
        const semiA = a.sf ? 1 : 0;
        const semiB = b.sf ? 1 : 0;
        return distanceA - distanceB || semiA - semiB || a.rank - b.rank;
      }),
    })),
  }));
---

<Base
  title={`${athlete.name} 선수 기록`}
  description={`${athlete.name} 선수의 출생년도, 소속, 나이별 성적, 전체 대회 이력을 정리한 페이지입니다.`}
  generatedAt={meta.generatedAt}
  contentWidth="narrow"
>
  <div class="top-link"><a href={withBase("athlete/")} onclick="if(window.history.length>1){window.history.back();return false;}">← 공개 선수 목록</a></div>
  <header class="card">
    <div>
      <h1>{athlete.name}</h1>
      <p class="subtitle">{subtitle}</p>
    </div>
    <div class="metrics">
      <div><div class="metric-main">{totalRaces}회</div><div class="metric-sub">전체 경기</div></div>
      <div class="highlight"><div class="metric-main">{goldCount}회</div><div class="metric-sub">1등</div></div>
      <div><div class="metric-main">{seasonSpan}</div><div class="metric-sub">{yearRange}</div></div>
    </div>
  </header>

  <section class="card">
    <h2>해마다 가장 잘한 등수</h2>
    <p class="section-note">막대가 길수록 좋은 성적이에요. 진한 막대는 1등을 한 해예요.</p>
    <div class="year-best">
      {
        yearBestRows.map(([year, best]) => {
          const width = Math.max(((11 - Math.min(best, 10)) / 10) * 100, 6);
          const isGold = best === 1;
          return (
            <div class="year-best-row">
              <span class="year">{year}</span>
              <span class="age">{athlete.birth !== null ? `${year - athlete.birth}살` : "-"}</span>
              <div class="bar-wrap">
                <span class="bar" style={`width:${width}%;background:${isGold ? "#2E63F6" : best <= 3 ? "#A9C3FA" : "#D3D8E0"}`}></span>
              </div>
              <span class="rank" style={`color:${isGold ? "#2E63F6" : "#5B5F68"}`}>{best}등</span>
            </div>
          );
        })
      }
    </div>
    <p class="hint">{missingNote}</p>
  </section>

  <section class="card">
    <h2>전체 대회 기록</h2>
    <p class="section-note">대회 하나가 카드 하나예요. 종목별 등수는 오른쪽에 나와요.</p>
    <div class="year-groups">
      {
        yearCards.map((yearGroup) => (
          <article class="year-group">
            <div class="sticky">
              <b>{yearGroup.year}년</b>
              <span>{athlete.birth !== null ? `${yearGroup.year - athlete.birth}살 · ` : ""}{yearGroup.meets.reduce((acc, meet) => acc + meet.results.length, 0)}경기</span>
            </div>
            <div class="meet-list">
              {yearGroup.meets.map((meet) => (
                <div class="meet-card">
                  <b>{meet.name}</b>
                  <div class="results">
                    {meet.results.map((result) => {
                      const groupLabel = normalizeGroupLabel(result.round);
                      const note = result.sf ? "준결승" : groupLabel === "종합" ? "종합 순위" : `${groupLabel}그룹 결승`;
                      return (
                        <div class="result-row">
                          <span class="distance">{result.distance ?? "-"}m</span>
                          <span class="note">{note}</span>
                          <span class={`badge ${result.sf ? "semi" : result.rank === 1 ? "gold" : result.rank <= 3 ? "podium" : "normal"}`}>{result.rank}등</span>
                        </div>
                      );
                    })}
                  </div>
                </div>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="card">
    <h2>용어 안내</h2>
    <div class="glossary">
      <div><span>A그룹</span><p>상위 선수들이 겨루는 결승입니다. 같은 등수라도 A그룹이 더 높은 순위입니다.</p></div>
      <div><span>B그룹</span><p>A그룹에 들지 못한 선수들의 결승입니다.</p></div>
      <div><span>종합</span><p>전국동계체육대회처럼 그룹을 나누지 않고 매긴 순위입니다.</p></div>
      <div><span>준결승</span><p>결승 전 단계입니다. 조 안에서 매긴 등수라 전체 순위와 다릅니다.</p></div>
    </div>
  </section>

  <section class="card">
    <h2>개인정보 삭제/처리정지 요청</h2>
    <p class="section-note">
      선수 정보 열람·정정·삭제·처리정지를 요청하실 수 있어요. 요청 방법과 처리 기준은 개인정보 처리방침 페이지에 안내돼 있어요.
    </p>
    <div class="request-row">
      <span>요청 접수 메일(예시): privacy@example.com</span>
      <a href={withBase("privacy/#request")}>요청 안내 보기</a>
    </div>
  </section>

  <style>
    .top-link {
      padding: 16px 2px 4px;
    }
    .top-link a {
      font-size: 14px;
      font-weight: 600;
      color: #6b6f78;
    }
    .card {
      background: #ffffff;
      border-radius: 20px;
      padding: 22px 20px;
      margin-bottom: 12px;
    }
    h1 {
      margin: 0;
      font-size: 30px;
      font-weight: 800;
      letter-spacing: -0.03em;
    }
    .subtitle {
      margin: 5px 0 0;
      font-size: 15px;
      color: #6b6f78;
    }
    .metrics {
      margin-top: 16px;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
    }
    .metrics > div {
      background: #f5f7fa;
      border-radius: 14px;
      padding: 12px 12px 11px;
    }
    .metrics > .highlight {
      background: #e9f0ff;
    }
    .metric-main {
      font-size: 22px;
      font-weight: 800;
      letter-spacing: -0.02em;
    }
    .metric-sub {
      font-size: 12.5px;
      color: #8a8f99;
      margin-top: 1px;
    }
    h2 {
      margin: 0 0 4px;
      font-size: 18px;
      font-weight: 800;
      letter-spacing: -0.02em;
    }
    .section-note {
      margin: 0 0 14px;
      font-size: 14px;
      color: #6b6f78;
    }
    .year-best {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }
    .year-best-row {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .year {
      font-size: 13px;
      color: #8a8f99;
      width: 38px;
      flex: none;
      font-variant-numeric: tabular-nums;
    }
    .age {
      font-size: 12px;
      color: #c6cbd4;
      width: 36px;
      flex: none;
    }
    .bar-wrap {
      flex: 1;
      height: 20px;
      background: #f2f4f7;
      border-radius: 6px;
      position: relative;
    }
    .bar {
      position: absolute;
      left: 0;
      top: 0;
      height: 20px;
      border-radius: 6px;
    }
    .rank {
      font-size: 13.5px;
      font-weight: 700;
      width: 34px;
      text-align: right;
      flex: none;
    }
    .hint {
      margin: 16px 0 0;
      font-size: 13px;
      color: #9ba0aa;
    }
    .year-groups {
      display: flex;
      flex-direction: column;
      gap: 22px;
    }
    .sticky {
      padding: 6px 4px 10px;
      display: flex;
      align-items: baseline;
      gap: 8px;
    }
    .sticky b {
      font-size: 17px;
      font-weight: 800;
      letter-spacing: -0.02em;
    }
    .sticky span {
      font-size: 13px;
      color: #9ba0aa;
    }
    .meet-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .meet-card {
      background: #fafbfc;
      border-radius: 16px;
      padding: 14px 14px 12px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .meet-card b {
      font-size: 15px;
      font-weight: 700;
      line-height: 1.4;
      letter-spacing: -0.01em;
    }
    .results {
      display: flex;
      flex-direction: column;
      gap: 1px;
    }
    .result-row {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 7px 2px;
      border-top: 1px solid #f0f2f5;
    }
    .distance {
      font-size: 14.5px;
      font-weight: 600;
      color: #3a3d45;
      width: 62px;
      flex: none;
      font-variant-numeric: tabular-nums;
    }
    .note {
      font-size: 12.5px;
      color: #a9aeb8;
    }
    .badge {
      margin-left: auto;
      flex: none;
      min-width: 46px;
      text-align: center;
      font-size: 14px;
      font-weight: 700;
      border-radius: 10px;
      padding: 5px 10px;
      font-variant-numeric: tabular-nums;
    }
    .badge.gold {
      background: #2e63f6;
      color: #ffffff;
    }
    .badge.podium {
      background: #e9f0ff;
      color: #2e63f6;
    }
    .badge.normal {
      background: #f2f4f7;
      color: #5b5f68;
    }
    .badge.semi {
      background: #f2f4f7;
      color: #9ba0aa;
    }
    .glossary {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .glossary div {
      display: flex;
      gap: 10px;
      align-items: flex-start;
    }
    .glossary span {
      flex: none;
      min-width: 46px;
      text-align: center;
      font-size: 12px;
      font-weight: 700;
      color: #5b5f68;
      background: #f2f4f7;
      border-radius: 8px;
      padding: 4px 8px;
    }
    .glossary p {
      margin: 0;
      font-size: 14px;
      color: #5b5f68;
    }
    .request-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      background: #f5f7fa;
      border-radius: 14px;
      padding: 12px 14px;
    }
    .request-row span {
      font-size: 13.5px;
      color: #5b5f68;
    }
    .request-row a {
      font-size: 13.5px;
      font-weight: 700;
      color: #2e63f6;
      white-space: nowrap;
      text-decoration: none;
    }
    .request-row a:hover {
      text-decoration: underline;
    }
    @media (max-width: 640px) {
      .metrics {
        grid-template-columns: 1fr;
      }
      .request-row {
        align-items: flex-start;
        flex-direction: column;
      }
    }
  </style>
</Base>
