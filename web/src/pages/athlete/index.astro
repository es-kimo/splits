---
import Base from "../../layouts/Base.astro";
import { withBase } from "../../lib/base";
import { loadAthletesDoc, loadMetaDoc } from "../../lib/data";

const { athletes } = loadAthletesDoc();
const meta = loadMetaDoc();
---

<Base
  title="쇼트트랙 공개 선수 목록"
  description="공개 대상 선수의 개별 기록 페이지로 이동할 수 있는 쇼트트랙 선수 목록입니다."
  generatedAt={meta.generatedAt}
>
  <header class="page-head">
    <h1>공개 선수 목록</h1>
    <p class="lead">선수를 누르면 나이별 성적과 전체 대회 기록을 볼 수 있어요.</p>
  </header>

  <section class="card is-flush">
    <div class="list">
      {
        athletes.map((athlete) => {
          const raceCount = athlete.history.length;
          const goldCount = athlete.history.filter((item) => item.rank === 1 && !item.sf).length;
          const metaText = `${athlete.birth ?? "출생년도 미상"}${athlete.birth ? "년생" : ""} · ${athlete.team}${athlete.gender ? ` · ${athlete.gender}` : ""}`;
          return (
            <a class="row-link athlete-row" href={withBase(athlete.url)}>
              <div class="row-head">
                <b>{athlete.name}</b>
                <span class="row-cta">자세히 보기 ›</span>
              </div>
              <div class="row-meta">{metaText}</div>
              <div class="badge-row">
                <span class="badge">전체 {raceCount}경기</span>
                <span class="badge is-point">1등 {goldCount}회</span>
              </div>
            </a>
          );
        })
      }
    </div>
  </section>

  <style>
    .athlete-row {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .row-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }
    .row-head b {
      font-size: 16px;
      font-weight: 700;
      letter-spacing: -0.01em;
    }
    .row-cta {
      flex: none;
      font-size: 12.5px;
      font-weight: 700;
      color: var(--point);
      white-space: nowrap;
    }
    .row-meta {
      font-size: 13.5px;
      color: var(--sub-2);
    }
  </style>
</Base>
