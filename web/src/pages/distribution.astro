---
// 예전 주소. 조회 도구는 홈으로 합쳤습니다. 외부 링크와 OG 공유를 위해 리다이렉트만 남깁니다.
import { toAbsoluteUrl, withBase } from "../lib/base";

const homePath = withBase();
const homeUrl = toAbsoluteUrl();
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>또래 기록 분포 조회 — 스플릿</title>
    <meta name="robots" content="noindex,follow" />
    <meta http-equiv="refresh" content={`0;url=${homePath}`} />
    <link rel="canonical" href={homeUrl} />
    <link rel="icon" href={withBase("favicon.ico")} sizes="32x32" />
    <script is:inline define:vars={{ homePath }}>
      window.location.replace(homePath);
    </script>
  </head>
  <body style="margin:0;padding:40px 16px;font-family:Pretendard,sans-serif;background:#F3F5F8;color:#5B5F68">
    <p style="margin:0;font-size:15px">
      조회 도구는 첫 화면으로 옮겼어요. <a href={homePath} style="color:#2E63F6;font-weight:700">바로 가기</a>
    </p>
  </body>
</html>
