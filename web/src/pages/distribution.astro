---
import DistributionTool from "../components/DistributionTool";
import Base from "../layouts/Base.astro";
import { withBase } from "../lib/base";
import { loadDistributionDoc, loadMetaDoc } from "../lib/data";

const distribution = loadDistributionDoc();
const meta = loadMetaDoc();
---

<Base
  title="또래 기록 분포 조회"
  description="출생연도·성별·학령구간·거리 조건에서 기록 또는 순위의 상대 위치를 확인합니다."
  generatedAt={meta.generatedAt}
>
  <div class="top-link"><a href={withBase()}>← 메인으로</a></div>
  <header class="card">
    <h1>또래 기록 분포 조회</h1>
    <p>같은 조건 집단에서 기록이나 순위가 어느 위치인지 바로 확인할 수 있어요.</p>
  </header>
  <section class="card">
    <h2>분포 입력</h2>
    <p class="section-note">출생연도·성별·학령구간·거리를 고르고 기록 또는 순위를 입력해 보세요.</p>
    <DistributionTool
      client:visible
      kAnonymityMin={distribution.kAnonymityMin}
      insufficientText={distribution.insufficientText}
      filters={distribution.filters}
      rows={distribution.rows}
    />
  </section>
  <section class="card notice-card">
    <h2>해석할 때 꼭 확인해 주세요</h2>
    <ul>
      <li>기록 분포는 예선 기록 기준입니다.</li>
      <li>2012년 이전 구간은 데이터가 부족합니다.</li>
      <li>인원 10명 미만 구간은 데이터 부족으로만 표시합니다.</li>
      <li>이 결과는 진로 판단 근거가 아닙니다.</li>
    </ul>
  </section>
  <style>
    .top-link {
      padding: 16px 2px 4px;
    }
    .top-link a {
      font-size: 14px;
      font-weight: 600;
      color: #6b6f78;
    }
    .card {
      background: #ffffff;
      border-radius: 20px;
      padding: 22px 20px;
      margin-bottom: 12px;
    }
    h1 {
      margin: 0;
      font-size: 29px;
      font-weight: 800;
      letter-spacing: -0.03em;
    }
    h2 {
      margin: 0 0 6px;
      font-size: 20px;
      font-weight: 800;
      letter-spacing: -0.02em;
    }
    p {
      margin: 4px 0 0;
      font-size: 14px;
      color: #6b6f78;
    }
    .section-note {
      margin: 0 0 14px;
    }
    .notice-card ul {
      margin: 8px 0 0;
      padding-left: 18px;
      color: #5b5f68;
      font-size: 14px;
      line-height: 1.6;
    }
    .notice-card li + li {
      margin-top: 4px;
    }
  </style>
</Base>
