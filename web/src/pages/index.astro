---
import DistributionTool from "../components/DistributionTool";
import Base from "../layouts/Base.astro";
import { withBase } from "../lib/base";
import { loadDistributionDoc, loadMetaDoc } from "../lib/data";

const distribution = loadDistributionDoc();
const meta = loadMetaDoc();

const placementCount = `${(meta.placementCount || 0).toLocaleString("ko-KR")}개`;
const yearSpan =
  meta.yearStart !== null && meta.yearEnd !== null ? `${meta.yearStart}년 ~ ${meta.yearEnd}년` : "연도 정보 없음";
---

<Base
  title="우리 아이 기록, 또래 중 어디쯤일까요 — 스플릿"
  description="비교할 조건을 고르고 기록이나 등수를 넣으면, 또래 중 어디쯤인지 한 줄로 알려드립니다. 국내 쇼트트랙 공개 경기 기록을 정리했습니다."
  ogTitle="우리 아이 기록, 또래 중 어디쯤일까요"
  ogImage="og-default.png"
  generatedAt={meta.generatedAt}
>
  <header class="page-head">
    <h1>우리 아이 기록,<br />또래 중에 어디쯤일까요?</h1>
    <p class="lead">비교할 조건을 고르고 기록이나 등수를 넣으면, 또래 중 어디쯤인지 한 줄로 알려드려요.</p>
  </header>

  <DistributionTool
    client:visible
    showTopLink={false}
    showHero={false}
    homeUrl={withBase()}
    kAnonymityMin={distribution.kAnonymityMin}
    insufficientText={distribution.insufficientText}
    filters={distribution.filters}
    rows={distribution.rows}
  />
  <noscript>
    <section class="card">
      <p class="hint">자바스크립트가 꺼져 있으면 조건을 바꿔 조회할 수 없어요. 지금 보이는 기본 비교 결과를 먼저 확인해주세요.</p>
    </section>
  </noscript>

  <section class="card">
    <div class="card-head">
      <h2>이 숫자는 어디서 왔나요?</h2>
      <p>대한체육회가 공개한 경기 결과를 그대로 모았어요. 나온 선수가 적어 개인이 짐작될 수 있는 구간은 보여드리지 않아요.</p>
    </div>
    <div class="metric-grid is-2">
      <div class="metric">
        <b>{placementCount}</b>
        <span>모아둔 경기 성적</span>
      </div>
      <div class="metric">
        <b>{meta.athleteCount || 0}명</b>
        <span>기록을 볼 수 있는 국가대표</span>
      </div>
    </div>
    <p class="hint">자료 범위: {yearSpan}</p>
    <a class="chip analysis-link" href={withBase("analysis/")}>상위 단계 도달자의 유년기 분포 보기 →</a>
  </section>

  <style>
    .analysis-link {
      margin-top: 14px;
      background: var(--point-bg);
      color: var(--point);
      font-weight: 700;
    }
    .analysis-link:hover {
      background: var(--point-bg-2);
      color: var(--point);
    }
  </style>
</Base>
