---
import DistributionTool from "../components/DistributionTool";
import Base from "../layouts/Base.astro";
import { withBase } from "../lib/base";
import { loadDistributionDoc, loadMetaDoc } from "../lib/data";

const distribution = loadDistributionDoc();
const meta = loadMetaDoc();

const placementCount = `${(meta.placementCount || 0).toLocaleString("ko-KR")}개`;
const top2Count = `${meta.elemTop2Count || 0}명`;
const yearSpan =
  meta.yearStart !== null && meta.yearEnd !== null ? `${meta.yearStart}년 ~ ${meta.yearEnd}년` : "연도 정보 없음";
---

<Base
  title="또래 기록 분포 조회"
  description="우리 아이 기록이 또래 중 어디쯤인지 30초 안에 확인할 수 있습니다. 조건을 고르고 기록 또는 등수를 입력하면 상위 위치를 바로 보여줍니다."
  ogTitle="또래 기록 분포 조회"
  ogImage="og-default.png"
  generatedAt={meta.generatedAt}
>
  <header class="page-head">
    <span class="eyebrow">답부터 확인</span>
    <h1>우리 아이 기록,<br />또래 중 어디쯤인지 바로 확인해요</h1>
    <p class="lead">비교 조건을 고르고 기록이나 등수를 넣으면 상위 몇 %인지 한 줄로 보여드려요.</p>
  </header>

  <DistributionTool
    client:visible
    showTopLink={false}
    showHero={false}
    homeUrl={withBase()}
    kAnonymityMin={distribution.kAnonymityMin}
    insufficientText={distribution.insufficientText}
    filters={distribution.filters}
    rows={distribution.rows}
  />

  <section class="card">
    <div class="card-head">
      <h2>이 숫자를 왜 믿을 수 있나요?</h2>
      <p>집계 기준과 원자료를 함께 공개하고, 데이터가 부족한 구간은 공개하지 않습니다.</p>
    </div>
    <div class="metric-grid">
      <div class="metric">
        <b>{meta.athleteCount || 0}명</b>
        <span>국가대표 유년기 데이터 공개</span>
      </div>
      <div class="metric">
        <b>{placementCount}</b>
        <span>분석에 사용된 경기 성적</span>
      </div>
      <div class="metric">
        <b>{top2Count}</b>
        <span>초등부 1~2등 경험</span>
      </div>
    </div>
    <p class="hint">자료 범위: {yearSpan}. 계산 기준과 선수별 원자료는 분석 페이지에서 확인할 수 있어요.</p>
    <a class="chip analysis-link" href={withBase("analysis/")}>국가대표 {meta.athleteCount || 0}명 원자료 보기 →</a>
  </section>

  <style>
    .analysis-link {
      margin-top: 14px;
      background: var(--point-bg);
      color: var(--point);
      font-weight: 700;
    }
    .analysis-link:hover {
      background: var(--point-bg-2);
      color: var(--point);
    }
  </style>
</Base>
