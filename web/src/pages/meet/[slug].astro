---
import Base from "../../layouts/Base.astro";
import { withBase } from "../../lib/base";
import { loadMeetsDoc, loadMetaDoc } from "../../lib/data";
import { classifyMeetKind, formatMeetDateRange, isNationalMeetKind, meetSlug, shortenMeetTitle } from "../../lib/meet";
import type { MeetItem, MeetPublicFigurePlacement } from "../../lib/types";

export function getStaticPaths() {
  const { items } = loadMeetsDoc();
  return items.map((item) => ({
    params: { slug: meetSlug(item) },
    props: { item },
  }));
}

const { item } = Astro.props as { item: MeetItem };
const meta = loadMetaDoc();
const kind = classifyMeetKind(item.meet);
const isNational = isNationalMeetKind(kind);
const dateRange = formatMeetDateRange(item.dateStart ?? null, item.dateEnd ?? null);
const locationTextRaw = String(item.location ?? "").trim();
const hasLocation = locationTextRaw.length > 0;
const shortTitle = shortenMeetTitle(item.meet) || item.meet;
const hasLongTitle = shortTitle !== item.meet;
const categoryBreakdown = (item.categoryBreakdown ?? []).slice().sort((a, b) => b.athleteCount - a.athleteCount);
const maxCategoryCount = categoryBreakdown.length > 0 ? Math.max(...categoryBreakdown.map((row) => row.athleteCount)) : 1;
const distributionRows = (item.distanceDistribution?.items ?? []).slice().sort((a, b) => a.distance - b.distance);
const distributionPayload = distributionRows.map((row) => ({
  distance: row.distance,
  insufficient: row.insufficient,
  p10: row.timeP10,
  p25: row.timeP25,
  p50: row.timeP50,
  p75: row.timeP75,
  p90: row.timeP90,
}));
const defaultDistributionRow =
  distributionRows.find(
    (row) =>
      !row.insufficient &&
      row.timeP10 !== null &&
      row.timeP25 !== null &&
      row.timeP50 !== null &&
      row.timeP75 !== null &&
      row.timeP90 !== null,
  ) ?? distributionRows[0] ?? null;
const defaultDistance = defaultDistributionRow?.distance ?? 0;
const figures = item.publicFigureResults ?? [];
const seriesRows = [{ year: item.year, meet: item.meet, url: item.url || `meet/${meetSlug(item)}/`, current: true }]
  .concat((item.seriesLinks ?? []).map((row) => ({ ...row, current: false })))
  .sort((a, b) => b.year - a.year);
const ogTitle = `${item.meet} 결과`;
const fallbackSeriesLink = seriesRows.find((row) => !row.current) ?? null;

const hasUsableDefaultDistribution =
  defaultDistributionRow !== null &&
  !defaultDistributionRow.insufficient &&
  defaultDistributionRow.timeP10 !== null &&
  defaultDistributionRow.timeP25 !== null &&
  defaultDistributionRow.timeP50 !== null &&
  defaultDistributionRow.timeP75 !== null &&
  defaultDistributionRow.timeP90 !== null;

const unavailableMessage =
  distributionRows.length === 0
    ? "이 대회는 종목별 예선 기록이 아직 정리되지 않아 분포를 보여드리기 어렵습니다."
    : "참가 선수가 적어 개인이 특정될 수 있는 종목이라, 분포를 공개하지 않습니다.";

function formatSeconds(sec: number): string {
  if (sec < 60) return `${sec.toFixed(2)}초`;
  const minutes = Math.floor(sec / 60);
  const seconds = sec - minutes * 60;
  return `${minutes}분 ${seconds < 10 ? "0" : ""}${seconds.toFixed(2)}초`;
}

function formatPlacementChip(placement: MeetPublicFigurePlacement): string {
  const distance = placement.distance !== null ? `${placement.distance}m` : "-";
  return `${distance} ${placement.rank}등`;
}

function placementTone(placement: MeetPublicFigurePlacement): string {
  if (placement.sf) return "is-mute";
  if (placement.rank === 1) return "is-gold";
  return "is-podium";
}
---

<Base
  title={`${item.meet} (${item.year})`}
  description={`${item.year}년 ${item.meet} 대회 상세 데이터`}
  ogTitle={ogTitle}
  ogImage="og-competition.png"
  generatedAt={meta.generatedAt}
  back={{ href: withBase("meet/"), label: "대회 목록" }}
>
  <header class="page-head is-tight">
    <div class="badge-row">
      <span class="badge">{kind}</span>
      {isNational && <span class="badge is-point">전국 규모</span>}
    </div>
    <h1>{shortTitle}</h1>
    {hasLongTitle && <p class="official-name">{item.meet}</p>}
    <p class="lead">
      {dateRange}
      {hasLocation && (
        <>
          <br />
          {locationTextRaw}
        </>
      )}
    </p>
  </header>

  <section class="card">
    <div class="metric-grid">
      <div class="metric"><b>{item.raceCount}건</b><span>치러진 경기</span></div>
      <div class="metric"><b>{item.athleteCount}명</b><span>참가 선수</span></div>
      <div class="metric">
        <b>{item.distanceSet.length}종목</b>
        <span>{item.distanceSet.length > 0 ? `${Math.min(...item.distanceSet)}~${Math.max(...item.distanceSet)}m` : "종목 정보 없음"}</span>
      </div>
    </div>
  </section>

  <section class="card">
    <div class="card-head">
      <h2>기록이 어디쯤이면 잘한 걸까요?</h2>
      <p>이 대회 예선 기록을 빠른 순서대로 정리했어요. 종목을 고르고 기록을 눌러서 골라주면 대략적인 위치를 확인할 수 있어요.</p>
    </div>

    <div id="distTabs" class="chip-row is-wrap tab-row" role="group" aria-label="종목 선택">
      {
        distributionRows.length > 0 ? (
          distributionRows.map((row) => (
            <button
              type="button"
              class={`chip ${row.distance === defaultDistance ? "is-active" : ""}`}
              data-distance={row.distance}
              aria-pressed={row.distance === defaultDistance}
            >
              {row.distance}m
            </button>
          ))
        ) : (
          <div class="dist-tabs-empty">종목별 기록이 준비되면 이 자리에서 비교할 수 있어요.</div>
        )
      }
    </div>

    <div class="tile distribution-box">
      <div class="scale-header"><span>빠른 기록</span><span>느린 기록</span></div>
      <div class="scale-bar">
        <div></div><div></div><div></div><div></div>
      </div>
      <div id="bandValues" class="band-values">
        {
          hasUsableDefaultDistribution ? (
            <>
              <span>{formatSeconds(defaultDistributionRow!.timeP10!)}</span>
              <span>{formatSeconds(defaultDistributionRow!.timeP25!)}</span>
              <span>{formatSeconds(defaultDistributionRow!.timeP50!)}</span>
              <span>{formatSeconds(defaultDistributionRow!.timeP75!)}</span>
              <span>{formatSeconds(defaultDistributionRow!.timeP90!)}</span>
            </>
          ) : (
            <>
              <span>-</span><span>-</span><span>-</span><span>-</span><span>-</span>
            </>
          )
        }
      </div>
      <div class="band-names">
        <span>상위 10%</span><span>상위 25%</span><span>중간</span><span>하위 25%</span><span>하위 10%</span>
      </div>

      <div id="distUnavailable" class="dist-unavailable" role="status" aria-live="polite" hidden={hasUsableDefaultDistribution}>
        <div>{unavailableMessage}</div>
        <div class="dist-unavailable-next">
          {fallbackSeriesLink ? (
            <>
              같은 대회의 다른 해 기록도 함께 확인해보세요.
              <a href={withBase(fallbackSeriesLink.url)}> {fallbackSeriesLink.year}년 대회 보기</a>
            </>
          ) : (
            <>
              대회 목록에서 다른 대회나 종목을 선택해 비교해보세요.
              <a href={withBase("meet/")}> 대회 목록으로 이동</a>
            </>
          )}
        </div>
      </div>

      <div id="timeCheckBox" class="time-check-box" style={hasUsableDefaultDistribution ? undefined : "display:none"}>
        <div class="time-check-title">아이 기록을 눌러서 골라주세요</div>
        <div class="numpick">
          <div id="timeSlots" class="numpick-readout" role="group" aria-label="기록 자리 고르기"></div>
          <p id="timeSlotHint" class="numpick-hint"></p>
          <div id="timeKeys" class="numpick-grid" role="group" aria-label="숫자 고르기"></div>
        </div>
        <div id="timeResultBox" class="time-result" role="status" aria-live="polite" aria-atomic="true" hidden>
          <div id="timeResultTitle"></div>
          <div id="timeResultDetail"></div>
        </div>
      </div>
    </div>
    <noscript>
      <p class="hint">자바스크립트가 꺼져 있으면 종목 전환과 내 기록 비교는 동작하지 않아요. 위 기준값으로 먼저 위치를 확인해주세요.</p>
    </noscript>

    <p class="hint">참가 인원이 적은 종목은 개인이 특정될 수 있어 공개하지 않아요. 결승은 순위 운영 영향이 커서 예선 기록만 썼습니다.</p>
  </section>

  <section class="card">
    <div class="card-head">
      <h2>누가 나왔나요</h2>
      <p>종별로 참가 인원을 세어봤어요.</p>
    </div>
    <div class="category-list">
      {
        categoryBreakdown.map((row) => (
          <div class="category-row">
            <span class="category-name">{row.category}</span>
            <div class="bar-track"><span class="bar-fill" style={`width:${(row.athleteCount / maxCategoryCount) * 100}%`}></span></div>
            <span class="category-count">{row.athleteCount}명</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="card">
    <div class="card-head">
      <h2>이 대회에 나온 공개 선수</h2>
      <p>이 사이트에서 공개 중인 선수의 기록만 보여드려요.</p>
    </div>
    {
      figures.length === 0 ? (
        <div class="empty">
          <b>공개 선수 기록이 없습니다</b>
          <span>이 대회에 공개 대상 선수가 출전하지 않았거나, 기록이 남아 있지 않아요.</span>
        </div>
      ) : (
        <div class="list">
          {figures.map((figure) => (
            <article class="tile figure-card">
              <div class="figure-head">
                <b>{figure.name}</b>
                <span>최고 {figure.bestRank}등 · {figure.raceCount}경기</span>
                <a href={withBase(figure.url)}>기록 보기 ›</a>
              </div>
              <div class="badge-row">
                {figure.placements.map((placement) => (
                  <span class={`badge ${placementTone(placement)}`}>{formatPlacementChip(placement)}</span>
                ))}
              </div>
            </article>
          ))}
        </div>
      )
    }
  </section>

  <section class="card">
    <div class="card-head">
      <h2>같은 대회, 다른 해</h2>
      <p>해마다 기록이 어떻게 달라졌는지 이어서 볼 수 있어요.</p>
    </div>
    <div class="chip-row">
      {
        seriesRows.map((row) =>
          row.current ? <span class="chip is-active">{row.year}년</span> : <a class="chip" href={withBase(row.url)}>{row.year}년</a>
        )
      }
    </div>
  </section>

  <script type="application/json" id="meetDistData" set:html={JSON.stringify(distributionPayload)}></script>
  <script is:inline>
    (() => {
      const distDataEl = document.getElementById("meetDistData");
      const distTabs = document.getElementById("distTabs");
      const bandValues = document.getElementById("bandValues");
      const distUnavailable = document.getElementById("distUnavailable");
      const timeCheckBox = document.getElementById("timeCheckBox");
      const timeSlots = document.getElementById("timeSlots");
      const timeSlotHint = document.getElementById("timeSlotHint");
      const timeKeys = document.getElementById("timeKeys");
      const timeResultBox = document.getElementById("timeResultBox");
      const timeResultTitle = document.getElementById("timeResultTitle");
      const timeResultDetail = document.getElementById("timeResultDetail");
      if (
        !(distDataEl instanceof HTMLScriptElement) ||
        !(distTabs instanceof HTMLElement) ||
        !(bandValues instanceof HTMLElement) ||
        !(distUnavailable instanceof HTMLElement) ||
        !(timeCheckBox instanceof HTMLElement) ||
        !(timeSlots instanceof HTMLElement) ||
        !(timeSlotHint instanceof HTMLElement) ||
        !(timeKeys instanceof HTMLElement) ||
        !(timeResultBox instanceof HTMLElement) ||
        !(timeResultTitle instanceof HTMLElement) ||
        !(timeResultDetail instanceof HTMLElement)
      ) {
        return;
      }

      const rows = JSON.parse(distDataEl.textContent || "[]");
      if (!Array.isArray(rows) || rows.length === 0) {
        bandValues.innerHTML = "<span>-</span><span>-</span><span>-</span><span>-</span><span>-</span>";
        distUnavailable.hidden = false;
        distUnavailable.innerHTML =
          "이 대회는 종목별 예선 기록이 아직 정리되지 않아 분포를 보여드리기 어렵습니다.<br>같은 대회의 다른 해를 보거나 대회 목록에서 다른 종목을 확인해보세요.";
        timeCheckBox.style.display = "none";
        return;
      }
      const initialDistanceButton = distTabs.querySelector("button[data-distance].is-active");
      const state = {
        distance: Number((initialDistanceButton instanceof HTMLButtonElement ? initialDistanceButton.dataset.distance : rows[0].distance) || 0),
        pickerTime: null,
        activeSlot: 0,
      };
      const insufficientMessage =
        "참가 선수가 적어 개인이 특정될 수 있는 종목이라 분포를 공개하지 않습니다.<br>다른 종목을 선택하거나 같은 대회의 다른 해를 확인해보세요.";

      const fmt = (sec) => {
        if (sec == null || Number.isNaN(sec)) return "-";
        if (sec < 60) return `${Number(sec).toFixed(2)}초`;
        const minutes = Math.floor(sec / 60);
        const seconds = sec - minutes * 60;
        return `${minutes}분 ${seconds < 10 ? "0" : ""}${seconds.toFixed(2)}초`;
      };

      const usable = (row) => Boolean(row) && !row.insufficient && row.p10 != null;

      const selectedRow = () => rows.find((row) => Number(row.distance) === Number(state.distance)) || rows[0];
      const roundTime = (value) => Math.max(0, Math.round(Number(value) * 10) / 10);
      const needsMinutes = () => {
        const row = selectedRow();
        return usable(row) && Number(row.p90) >= 60;
      };
      const slotDefs = () => {
        const defs = [];
        if (needsMinutes()) {
          const row = selectedRow();
          defs.push({
            key: "min",
            unit: "분",
            name: "분",
            hint: "몇 분이었는지 골라주세요",
            max: Math.max(1, Math.min(9, Math.floor(Number(row.p90) / 60) + 1)),
          });
        }
        defs.push({ key: "tens", unit: "", name: "초 앞자리", hint: "초의 앞자리예요. 29초라면 2를 눌러주세요", max: 5 });
        defs.push({ key: "ones", unit: ".", name: "초 뒷자리", hint: "초의 뒷자리예요. 29초라면 9를 눌러주세요", max: 9 });
        defs.push({ key: "tenth", unit: "초", name: "소수점 첫자리", hint: "소수점 첫자리예요. 29.1초라면 1을 눌러주세요", max: 9 });
        return defs;
      };
      const digitsOf = (value) => {
        const totalTenths = Math.max(0, Math.round(Number(value || 0) * 10));
        const whole = Math.floor(totalTenths / 10);
        const withMinutes = needsMinutes();
        const rest = withMinutes ? whole % 60 : whole;
        return {
          min: withMinutes ? Math.floor(whole / 60) : 0,
          tens: Math.floor(rest / 10),
          ones: rest % 10,
          tenth: totalTenths % 10,
        };
      };
      const composeDigits = (digits) =>
        roundTime(digits.min * 60 + digits.tens * 10 + digits.ones + digits.tenth / 10);
      const renderPicker = () => {
        const row = selectedRow();
        if (!usable(row)) {
          timeSlots.innerHTML = "";
          timeKeys.innerHTML = "";
          timeSlotHint.textContent = "";
          return;
        }
        const defs = slotDefs();
        state.activeSlot = Math.max(0, Math.min(state.activeSlot, defs.length - 1));
        const digits = digitsOf(state.pickerTime);
        timeSlots.innerHTML = defs
          .map((def, index) => {
            const active = index === state.activeSlot;
            const slot =
              '<button type="button" class="numpick-slot' +
              (active ? " is-active" : "") +
              '" data-slot="' + index +
              '" aria-pressed="' + active +
              '" aria-label="' + def.name + ' 고치기">' +
              digits[def.key] +
              "</button>";
            return def.unit ? slot + '<span class="numpick-unit">' + def.unit + "</span>" : slot;
          })
          .join("");
        const def = defs[state.activeSlot];
        timeSlotHint.textContent = def.hint;
        let keys = "";
        for (let value = 0; value <= def.max; value += 1) {
          const active = digits[def.key] === value;
          keys +=
            '<button type="button" class="numpick-key' +
            (active ? " is-active" : "") +
            '" data-key="' + value +
            '" aria-pressed="' + active + '">' +
            value +
            "</button>";
        }
        timeKeys.innerHTML = keys;
      };

      const renderTabs = () => {
        distTabs.querySelectorAll("button[data-distance]").forEach((button) => {
          if (!(button instanceof HTMLButtonElement)) return;
          const active = Number(button.dataset.distance || "0") === Number(state.distance);
          button.classList.toggle("is-active", active);
          button.setAttribute("aria-pressed", String(active));
        });
      };

      const renderBands = () => {
        const row = selectedRow();
        if (!row || row.insufficient || row.p10 == null) {
          bandValues.innerHTML = "<span>-</span><span>-</span><span>-</span><span>-</span><span>-</span>";
          distUnavailable.hidden = false;
          distUnavailable.innerHTML = insufficientMessage;
          timeCheckBox.style.display = "none";
          state.pickerTime = null;
          return;
        }
        bandValues.innerHTML = `
          <span>${fmt(row.p10)}</span>
          <span>${fmt(row.p25)}</span>
          <span>${fmt(row.p50)}</span>
          <span>${fmt(row.p75)}</span>
          <span>${fmt(row.p90)}</span>
        `;
        distUnavailable.hidden = true;
        timeCheckBox.style.display = "block";
        if (typeof state.pickerTime !== "number" || !Number.isFinite(state.pickerTime)) {
          state.pickerTime = roundTime(row.p50);
        }
        renderPicker();
      };

      const renderMyTimeResult = () => {
        const row = selectedRow();
        timeResultBox.hidden = true;
        if (!usable(row)) return;
        const parsed = state.pickerTime;
        if (typeof parsed !== "number" || !Number.isFinite(parsed)) return;

        const points = [
          [row.p10, 10],
          [row.p25, 25],
          [row.p50, 50],
          [row.p75, 75],
          [row.p90, 90],
        ];

        let percentile = 94;
        if (parsed <= row.p10) percentile = 8;
        else if (parsed < row.p90) {
          for (let i = 0; i < points.length - 1; i += 1) {
            const [startValue, startPercent] = points[i];
            const [endValue, endPercent] = points[i + 1];
            if (parsed >= startValue && parsed <= endValue) {
              const t = (parsed - startValue) / (endValue - startValue);
              percentile = startPercent + t * (endPercent - startPercent);
              break;
            }
          }
        }

        const rounded = Math.round(percentile);
        timeResultTitle.textContent = rounded <= 10 ? "상위 10% 안쪽이에요" : `참가자 중 상위 ${rounded}% 정도예요`;
        const gapToMid = row.p50 - parsed;
        timeResultDetail.textContent = `${fmt(parsed)} · 중간 기록(${fmt(row.p50)})보다 ${Math.abs(gapToMid).toFixed(2)}초 ${gapToMid >= 0 ? "빨라요" : "느려요"}`;
        timeResultBox.hidden = false;
      };

      const renderAll = () => {
        renderTabs();
        renderBands();
        renderMyTimeResult();
      };

      distTabs.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const button = target.closest("button[data-distance]");
        if (!(button instanceof HTMLButtonElement)) return;
        state.distance = Number(button.dataset.distance || "0");
        state.pickerTime = null;
        state.activeSlot = 0;
        renderAll();
      });

      timeSlots.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const button = target.closest("button[data-slot]");
        if (!(button instanceof HTMLButtonElement)) return;
        state.activeSlot = Number(button.dataset.slot || "0");
        renderPicker();
      });

      timeKeys.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const button = target.closest("button[data-key]");
        if (!(button instanceof HTMLButtonElement)) return;
        const defs = slotDefs();
        const def = defs[state.activeSlot];
        if (!def) return;
        const digits = digitsOf(state.pickerTime);
        digits[def.key] = Number(button.dataset.key || "0");
        state.pickerTime = composeDigits(digits);
        if (state.activeSlot < defs.length - 1) state.activeSlot += 1;
        renderPicker();
        renderMyTimeResult();
      });

      renderAll();
    })();
  </script>

  <style>
    .official-name {
      margin: -4px 0 0;
      font-size: 12.5px;
      color: var(--faint);
      line-height: 1.5;
    }
    .tab-row {
      margin-bottom: 14px;
    }
    .dist-tabs-empty {
      width: 100%;
      padding: 10px 12px;
      border-radius: var(--r-ctl);
      background: var(--surface-3);
      color: var(--sub-2);
      font-size: 13.5px;
    }
    .distribution-box {
      padding: 18px 16px 16px;
    }
    .scale-header {
      display: flex;
      justify-content: space-between;
      font-size: 12.5px;
      font-weight: 700;
      color: var(--soft);
      margin-bottom: 8px;
    }
    .scale-bar {
      display: flex;
      height: 32px;
      border-radius: 10px;
      overflow: hidden;
      background: var(--line);
    }
    .scale-bar div {
      flex: 1;
    }
    .scale-bar div:nth-child(1) {
