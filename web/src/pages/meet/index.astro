---
import Base from "../../layouts/Base.astro";
import { withBase } from "../../lib/base";
import { loadMeetsDoc, loadMetaDoc } from "../../lib/data";
import { classifyMeetKind, formatMeetDateRange, isNationalMeetKind, meetSlug, shortenMeetTitle } from "../../lib/meet";

const meta = loadMetaDoc();
const { items } = loadMeetsDoc();

const listPayload = items.map((item) => {
  const kind = classifyMeetKind(item.meet);
  const url = item.url || `meet/${meetSlug(item)}/`;
  const distances = [...new Set((item.distanceSet || []).filter((value): value is number => Number.isFinite(value)))].sort((a, b) => a - b);
  return {
    slug: meetSlug(item),
    href: withBase(url),
    year: item.year,
    meet: item.meet,
    short: shortenMeetTitle(item.meet),
    when: formatMeetDateRange(item.dateStart ?? null, item.dateEnd ?? null),
    where: item.location || "장소 정보 없음",
    kind,
    isNational: isNationalMeetKind(kind),
    distances,
  };
});

const totalMeets = listPayload.length;
const kindOrder = ["전체", "국가대표 선발", "전국체전", "선수권", "종별", "회장배", "국무총리배", "기타"];
const seenKinds = new Set(listPayload.map((item) => item.kind));
const kindOptions = kindOrder.filter((kind) => kind === "전체" || seenKinds.has(kind));
const distanceOptions = [0, ...Array.from(new Set(listPayload.flatMap((item) => item.distances))).sort((a, b) => a - b)];
const defaultRows = listPayload
  .slice()
  .sort((a, b) => b.year - a.year || String(a.meet).localeCompare(String(b.meet), "ko"));
const defaultYearGroups = new Map<number, typeof listPayload>();
for (const row of defaultRows) {
  const currentRows = defaultYearGroups.get(row.year);
  if (currentRows) currentRows.push(row);
  else defaultYearGroups.set(row.year, [row]);
}
---

<Base
  title="대회 목록"
  description="국내 쇼트트랙 대회를 검색하고 조건별로 찾아볼 수 있는 대회 목록 페이지입니다."
  generatedAt={meta.generatedAt}
>
  <header class="page-head">
    <h1>대회 찾기</h1>
    <p class="lead">2007년부터 열린 국내 쇼트트랙 대회 {totalMeets}개의 기록 요약이에요.</p>
  </header>

  <section class="card">
    <label class="field is-fill">
      <span class="field-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M20 20l-4-4"></path>
        </svg>
      </span>
      <input id="queryInput" type="text" placeholder="대회 이름이나 연도로 검색" autocomplete="off" />
      <button id="clearQueryButton" type="button" class="field-clear" aria-label="검색어 지우기" hidden>✕</button>
    </label>

    <div class="filter-block">
      <div class="filter-title">대회 종류</div>
      <div id="kindChips" class="chip-row">
        {
          kindOptions.map((kind) => (
            <button type="button" class={`chip${kind === "전체" ? " is-active" : ""}`} data-kind={kind}>
              {kind}
            </button>
          ))
        }
      </div>
    </div>
    <div class="filter-block">
      <div class="filter-title">종목</div>
      <div id="distChips" class="chip-row">
        {
          distanceOptions.map((distance) => (
            <button type="button" class={`chip${distance === 0 ? " is-active" : ""}`} data-distance={distance}>
              {distance === 0 ? "전체" : `${distance}m`}
            </button>
          ))
        }
      </div>
    </div>
    <noscript>
      <p class="hint">자바스크립트를 끄면 검색과 필터는 사용할 수 없지만, 아래 최신순 목록은 그대로 볼 수 있어요.</p>
    </noscript>
  </section>

  <div class="result-row">
    <span id="resultLabel">{totalMeets}개 대회</span>
    <button id="toggleOrderButton" type="button">최신순 ↓</button>
  </div>

  <section id="emptyState" class="card empty" hidden={totalMeets > 0}>
    <b>찾는 대회가 없습니다</b>
    <span>검색어를 지우거나 필터를 바꿔보세요.</span>
  </section>

  <section id="yearGroups" class="year-groups">
    {
      [...defaultYearGroups.entries()].map(([year, itemsByYear]) => (
        <section class="year-group">
          <div class="group-head">
            <b>{year}년</b>
            <span>{itemsByYear.length}개 대회</span>
          </div>
          <div class="list">
            {itemsByYear.map((entry) => (
              <a class="meet-card" href={entry.href}>
                <div class="meet-body">
                  <div class="badge-row">
                    <span class="badge">{entry.kind}</span>
                    {entry.isNational && <span class="badge is-point">전국 규모</span>}
                  </div>
                  <b class="meet-title">{entry.short || entry.meet}</b>
                  <div class="meet-meta">
                    {entry.when}
                    <br />
                    {entry.where}
                  </div>
                  <div class="badge-row">
                    {entry.distances.length === 0 ? (
                      <span class="badge">종목 정보 없음</span>
                    ) : (
                      entry.distances.map((distance) => <span class="badge">{distance}m</span>)
                    )}
                  </div>
                </div>
                <span class="meet-arrow">›</span>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </section>

  <script type="application/json" id="meetListData" set:html={JSON.stringify(listPayload)}></script>
  <script type="application/json" id="meetKindOptions" set:html={JSON.stringify(kindOptions)}></script>
  <script type="application/json" id="meetDistanceOptions" set:html={JSON.stringify(distanceOptions)}></script>

  <script is:inline>
    (() => {
      const dataEl = document.getElementById("meetListData");
      const kindOptionsEl = document.getElementById("meetKindOptions");
      const distOptionsEl = document.getElementById("meetDistanceOptions");
      const queryInput = document.getElementById("queryInput");
      const clearQueryButton = document.getElementById("clearQueryButton");
      const kindChips = document.getElementById("kindChips");
      const distChips = document.getElementById("distChips");
      const resultLabel = document.getElementById("resultLabel");
      const toggleOrderButton = document.getElementById("toggleOrderButton");
      const emptyState = document.getElementById("emptyState");
      const yearGroups = document.getElementById("yearGroups");
      if (
        !(dataEl instanceof HTMLScriptElement) ||
        !(kindOptionsEl instanceof HTMLScriptElement) ||
        !(distOptionsEl instanceof HTMLScriptElement) ||
        !(queryInput instanceof HTMLInputElement) ||
        !(clearQueryButton instanceof HTMLButtonElement) ||
        !(kindChips instanceof HTMLElement) ||
        !(distChips instanceof HTMLElement) ||
        !(resultLabel instanceof HTMLElement) ||
        !(toggleOrderButton instanceof HTMLButtonElement) ||
        !(emptyState instanceof HTMLElement) ||
        !(yearGroups instanceof HTMLElement)
      ) {
        return;
      }

      const rows = JSON.parse(dataEl.textContent || "[]");
      const kindOptions = JSON.parse(kindOptionsEl.textContent || "[]");
      const distanceOptions = JSON.parse(distOptionsEl.textContent || "[]");
      const state = { query: "", kind: "전체", dist: 0, newest: true };

      const escapeHtml = (value) =>
        String(value)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#39;");

      const renderKindChips = () => {
        kindChips.innerHTML = kindOptions
          .map((kind) => {
            const active = state.kind === kind;
            return `<button type="button" class="chip${active ? " is-active" : ""}" data-kind="${escapeHtml(kind)}">${escapeHtml(kind)}</button>`;
          })
          .join("");
      };

      const renderDistanceChips = () => {
        distChips.innerHTML = distanceOptions
          .map((distance) => {
            const active = state.dist === distance;
            const label = distance === 0 ? "전체" : `${distance}m`;
            return `<button type="button" class="chip${active ? " is-active" : ""}" data-distance="${distance}">${label}</button>`;
          })
          .join("");
      };

      const renderMeetRows = () => {
        const query = state.query.trim();
        const filtered = rows
          .filter((item) => {
            if (state.kind !== "전체" && item.kind !== state.kind) return false;
            if (state.dist !== 0 && !item.distances.includes(state.dist)) return false;
            if (!query) return true;
            return (
              item.short.includes(query) ||
              item.meet.includes(query) ||
              String(item.year).includes(query) ||
              item.where.includes(query) ||
              item.kind.includes(query)
            );
          })
          .sort((a, b) => {
            if (state.newest) return b.year - a.year || String(a.meet).localeCompare(String(b.meet), "ko");
            return a.year - b.year || String(a.meet).localeCompare(String(b.meet), "ko");
          });

        resultLabel.textContent = `${filtered.length}개 대회`;
        toggleOrderButton.textContent = state.newest ? "최신순 ↓" : "오래된순 ↑";
        clearQueryButton.hidden = state.query.length === 0;
        emptyState.hidden = filtered.length > 0;

        if (filtered.length === 0) {
          yearGroups.innerHTML = "";
          return;
        }

        const grouped = new Map();
        for (const item of filtered) {
          if (!grouped.has(item.year)) grouped.set(item.year, []);
          grouped.get(item.year).push(item);
        }

        yearGroups.innerHTML = [...grouped.entries()]
          .map(([year, itemsByYear]) => {
            const cards = itemsByYear
              .map((item) => {
                const distText =
                  item.distances.length === 0
                    ? '<span class="badge">종목 정보 없음</span>'
                    : item.distances.map((distance) => `<span class="badge">${distance}m</span>`).join("");
                return `
                  <a class="meet-card" href="${escapeHtml(item.href)}">
                    <div class="meet-body">
                      <div class="badge-row">
                        <span class="badge">${escapeHtml(item.kind)}</span>
                        ${item.isNational ? '<span class="badge is-point">전국 규모</span>' : ""}
                      </div>
                      <b class="meet-title">${escapeHtml(item.short || item.meet)}</b>
                      <div class="meet-meta">${escapeHtml(item.when)}<br>${escapeHtml(item.where)}</div>
                      <div class="badge-row">${distText}</div>
                    </div>
                    <span class="meet-arrow">›</span>
                  </a>
                `;
              })
              .join("");

            return `
              <section class="year-group">
                <div class="group-head">
                  <b>${year}년</b>
                  <span>${itemsByYear.length}개 대회</span>
                </div>
                <div class="list">${cards}</div>
              </section>
            `;
          })
          .join("");
      };

      queryInput.addEventListener("input", (event) => {
        const target = event.target;
        if (!(target instanceof HTMLInputElement)) return;
        state.query = target.value;
        renderMeetRows();
      });

      clearQueryButton.addEventListener("click", () => {
        state.query = "";
        queryInput.value = "";
        renderMeetRows();
      });

      toggleOrderButton.addEventListener("click", () => {
        state.newest = !state.newest;
        renderMeetRows();
      });

      kindChips.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const button = target.closest("button[data-kind]");
        if (!(button instanceof HTMLButtonElement)) return;
        state.kind = button.dataset.kind || "전체";
        renderKindChips();
        renderMeetRows();
      });

      distChips.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const button = target.closest("button[data-distance]");
        if (!(button instanceof HTMLButtonElement)) return;
        state.dist = Number(button.dataset.distance || "0");
        renderDistanceChips();
        renderMeetRows();
      });

      renderKindChips();
      renderDistanceChips();
      renderMeetRows();
    })();
  </script>

  <style>
    .filter-block {
      margin-top: 16px;
    }
    .filter-title {
      font-size: 13px;
      font-weight: 700;
      color: var(--soft);
      margin-bottom: 8px;
    }
    .result-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 6px;
    }
    .result-row span {
      font-size: 14px;
      color: var(--sub-2);
    }
    .result-row button {
      border: 0;
      background: transparent;
      font-size: 14px;
      font-weight: 700;
      color: var(--point);
      cursor: pointer;
      min-height: 44px;
      padding: 0 4px;
      white-space: nowrap;
    }
    .year-groups {
      display: flex;
      flex-direction: column;
      gap: var(--gap-section);
    }
    .year-groups :global(.meet-card) {
      background: var(--surface);
      border-radius: 18px;
      padding: 16px;
      display: flex;
      align-items: center;
      gap: 12px;
      color: inherit;
    }
    .year-groups :global(.meet-card:hover) {
      background: #fbfcfd;
      color: inherit;
    }
    .year-groups :global(.meet-body) {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 7px;
    }
    .year-groups :global(.meet-title) {
      font-size: 16px;
      font-weight: 700;
      letter-spacing: -0.01em;
      line-height: 1.4;
    }
    .year-groups :global(.meet-meta) {
      font-size: 13px;
      color: var(--soft);
      line-height: 1.5;
    }
    .year-groups :global(.meet-arrow) {
      flex: none;
      color: var(--faint-2);
      font-size: 20px;
    }
  </style>
</Base>
