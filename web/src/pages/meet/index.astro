---
import Base from "../../layouts/Base.astro";
import { withBase } from "../../lib/base";
import { loadMeetsDoc, loadMetaDoc } from "../../lib/data";
import { classifyMeetKind, formatMeetDateRange, isNationalMeetKind, meetSlug, shortenMeetTitle } from "../../lib/meet";

const meta = loadMetaDoc();
const { items } = loadMeetsDoc();

const listPayload = items.map((item) => {
  const kind = classifyMeetKind(item.meet);
  const url = item.url || `meet/${meetSlug(item)}/`;
  const distances = [...new Set((item.distanceSet || []).filter((value): value is number => Number.isFinite(value)))].sort((a, b) => a - b);
  return {
    slug: meetSlug(item),
    href: withBase(url),
    year: item.year,
    meet: item.meet,
    short: shortenMeetTitle(item.meet),
    when: formatMeetDateRange(item.dateStart ?? null, item.dateEnd ?? null),
    where: item.location || "장소 정보 없음",
    kind,
    isNational: isNationalMeetKind(kind),
    distances,
  };
});

const totalMeets = listPayload.length;
const kindOrder = ["전체", "국가대표 선발", "전국체전", "선수권", "종별", "회장배", "국무총리배", "기타"];
const seenKinds = new Set(listPayload.map((item) => item.kind));
const kindOptions = kindOrder.filter((kind) => kind === "전체" || seenKinds.has(kind));
const distanceOptions = [0, ...Array.from(new Set(listPayload.flatMap((item) => item.distances))).sort((a, b) => a - b)];
---

<Base
  title="대회 목록"
  description="국내 쇼트트랙 대회를 검색하고 조건별로 찾아볼 수 있는 대회 목록 페이지입니다."
  generatedAt={meta.generatedAt}
  contentWidth="narrow"
  contentLineHeight="compact"
  pageBottomPadding="60px"
  footerVariant="none"
>
  <div class="top-link"><a href={withBase()}>← 메인으로</a></div>

  <header class="hero card">
    <div>
      <h1>대회 찾기</h1>
      <p>2007년부터 열린 국내 쇼트트랙 대회 {totalMeets}개의 기록 요약입니다.</p>
    </div>
    <label class="search-box">
      <span class="search-icon">🔍</span>
      <input id="queryInput" type="text" placeholder="대회 이름이나 연도로 검색" autocomplete="off" />
      <button id="clearQueryButton" type="button" class="clear-btn" aria-label="검색어 지우기">✕</button>
    </label>
  </header>

  <section class="card filters-card">
    <div class="filter-title">대회 종류</div>
    <div id="kindChips" class="chip-row"></div>
    <div class="filter-title dist-title">종목</div>
    <div id="distChips" class="chip-row"></div>
  </section>

  <div class="result-row">
    <span id="resultLabel">0개 대회</span>
    <button id="toggleOrderButton" type="button">최신순 ↓</button>
  </div>

  <section id="emptyState" class="card empty-state" hidden>
    <div class="empty-title">찾는 대회가 없습니다</div>
    <div class="empty-sub">검색어를 지우거나 필터를 바꿔보세요.</div>
  </section>

  <section id="yearGroups" class="year-groups"></section>

  <footer class="legacy-footer">
    공개된 경기 결과를 정리한 페이지입니다. 개인이 특정될 수 있는 집계는 공개하지 않습니다.<br />
    출처: 대한체육회 경기결과 시스템
  </footer>

  <script type="application/json" id="meetListData" set:html={JSON.stringify(listPayload)}></script>
  <script type="application/json" id="meetKindOptions" set:html={JSON.stringify(kindOptions)}></script>
  <script type="application/json" id="meetDistanceOptions" set:html={JSON.stringify(distanceOptions)}></script>

  <script is:inline>
    (() => {
      const dataEl = document.getElementById("meetListData");
      const kindOptionsEl = document.getElementById("meetKindOptions");
      const distOptionsEl = document.getElementById("meetDistanceOptions");
      const queryInput = document.getElementById("queryInput");
      const clearQueryButton = document.getElementById("clearQueryButton");
      const kindChips = document.getElementById("kindChips");
      const distChips = document.getElementById("distChips");
      const resultLabel = document.getElementById("resultLabel");
      const toggleOrderButton = document.getElementById("toggleOrderButton");
      const emptyState = document.getElementById("emptyState");
      const yearGroups = document.getElementById("yearGroups");
      if (
        !(dataEl instanceof HTMLScriptElement) ||
        !(kindOptionsEl instanceof HTMLScriptElement) ||
        !(distOptionsEl instanceof HTMLScriptElement) ||
        !(queryInput instanceof HTMLInputElement) ||
        !(clearQueryButton instanceof HTMLButtonElement) ||
        !(kindChips instanceof HTMLElement) ||
        !(distChips instanceof HTMLElement) ||
        !(resultLabel instanceof HTMLElement) ||
        !(toggleOrderButton instanceof HTMLButtonElement) ||
        !(emptyState instanceof HTMLElement) ||
        !(yearGroups instanceof HTMLElement)
      ) {
        return;
      }

      const rows = JSON.parse(dataEl.textContent || "[]");
      const kindOptions = JSON.parse(kindOptionsEl.textContent || "[]");
      const distanceOptions = JSON.parse(distOptionsEl.textContent || "[]");
      const state = { query: "", kind: "전체", dist: 0, newest: true };

      const kindColor = {
        "국가대표 선발": ["#2E63F6", "#E9F0FF"],
        "전국체전": ["#B4700E", "#FDF1DC"],
        선수권: ["#7A3FC4", "#F1E9FC"],
        종별: ["#5B5F68", "#F2F4F7"],
        회장배: ["#5B5F68", "#F2F4F7"],
        국무총리배: ["#5B5F68", "#F2F4F7"],
        기타: ["#5B5F68", "#F2F4F7"],
      };

      const escapeHtml = (value) =>
        String(value)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#39;");

      const kindChipStyle = (kind) => {
        const palette = kindColor[kind] || kindColor["기타"];
        return `color:${palette[0]};background:${palette[1]};`;
      };

      const renderKindChips = () => {
        kindChips.innerHTML = kindOptions
          .map((kind) => {
            const active = state.kind === kind;
            return `<button type="button" class="chip-btn${active ? " active" : ""}" data-kind="${escapeHtml(kind)}">${escapeHtml(kind)}</button>`;
          })
          .join("");
      };

      const renderDistanceChips = () => {
        distChips.innerHTML = distanceOptions
          .map((distance) => {
            const active = state.dist === distance;
            const label = distance === 0 ? "전체" : `${distance}m`;
            return `<button type="button" class="chip-btn${active ? " active" : ""}" data-distance="${distance}">${label}</button>`;
          })
          .join("");
      };

      const renderMeetRows = () => {
        const query = state.query.trim();
        const filtered = rows
          .filter((item) => {
            if (state.kind !== "전체" && item.kind !== state.kind) return false;
            if (state.dist !== 0 && !item.distances.includes(state.dist)) return false;
            if (!query) return true;
            return (
              item.short.includes(query) ||
              item.meet.includes(query) ||
              String(item.year).includes(query) ||
              item.where.includes(query) ||
              item.kind.includes(query)
            );
          })
          .sort((a, b) => {
            if (state.newest) return b.year - a.year || String(a.meet).localeCompare(String(b.meet), "ko");
            return a.year - b.year || String(a.meet).localeCompare(String(b.meet), "ko");
          });

        resultLabel.textContent = `${filtered.length}개 대회`;
        toggleOrderButton.textContent = state.newest ? "최신순 ↓" : "오래된순 ↑";
        clearQueryButton.hidden = state.query.length === 0;
        emptyState.hidden = filtered.length > 0;

        if (filtered.length === 0) {
          yearGroups.innerHTML = "";
          return;
        }

        const grouped = new Map();
        for (const item of filtered) {
          if (!grouped.has(item.year)) grouped.set(item.year, []);
          grouped.get(item.year).push(item);
        }

        yearGroups.innerHTML = [...grouped.entries()]
          .map(([year, itemsByYear]) => {
            const cards = itemsByYear
              .map((item) => {
                const distChipsText =
                  item.distances.length === 0
                    ? '<span class="dist-chip">종목 정보 없음</span>'
                    : item.distances.map((distance) => `<span class="dist-chip">${distance}m</span>`).join("");
                return `
                  <a class="meet-card" href="${escapeHtml(item.href)}">
                    <div class="meet-body">
                      <div class="badge-row">
                        <span class="kind-badge" style="${kindChipStyle(item.kind)}">${escapeHtml(item.kind)}</span>
                        ${
                          item.isNational
                            ? '<span class="national-badge">전국 규모</span>'
                            : ""
                        }
                      </div>
                      <b class="meet-title">${escapeHtml(item.short || item.meet)}</b>
                      <div class="meta-text">${escapeHtml(item.when)}<br>${escapeHtml(item.where)}</div>
                      <div class="dist-row">${distChipsText}</div>
                    </div>
                    <span class="arrow">›</span>
                  </a>
                `;
              })
              .join("");

            return `
              <section class="year-group">
                <div class="year-head">
                  <b>${year}년</b>
                  <span>${itemsByYear.length}개 대회</span>
                </div>
                <div class="year-card-list">${cards}</div>
              </section>
            `;
          })
          .join("");
      };

      queryInput.addEventListener("input", (event) => {
        const target = event.target;
        if (!(target instanceof HTMLInputElement)) return;
        state.query = target.value;
        renderMeetRows();
      });

      clearQueryButton.addEventListener("click", () => {
        state.query = "";
        queryInput.value = "";
        renderMeetRows();
      });

      toggleOrderButton.addEventListener("click", () => {
        state.newest = !state.newest;
        renderMeetRows();
      });

      kindChips.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const button = target.closest("button[data-kind]");
        if (!(button instanceof HTMLButtonElement)) return;
        state.kind = button.dataset.kind || "전체";
        renderKindChips();
        renderMeetRows();
      });

      distChips.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const button = target.closest("button[data-distance]");
        if (!(button instanceof HTMLButtonElement)) return;
        state.dist = Number(button.dataset.distance || "0");
        renderDistanceChips();
        renderMeetRows();
      });

      renderKindChips();
      renderDistanceChips();
      renderMeetRows();
    })();
  </script>

  <style>
    .top-link {
      padding: 16px 2px 4px;
    }
    .top-link a {
      font-size: 14px;
      font-weight: 600;
      color: #6b6f78;
    }
    .card {
      background: #fff;
      border-radius: 20px;
      padding: 22px 20px;
    }
    .hero {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    h1 {
      margin: 0;
      font-size: 29px;
      font-weight: 800;
      letter-spacing: -0.03em;
    }
    .hero p {
      margin: 5px 0 0;
      font-size: 15px;
      color: #6b6f78;
    }
    .search-box {
      display: flex;
      align-items: center;
      gap: 10px;
      background: #f2f4f7;
      border-radius: 14px;
      padding: 0 14px;
      min-height: 50px;
    }
    .search-icon {
      font-size: 16px;
      color: #a9aeb8;
    }
    .search-box input {
      flex: 1;
      border: 0;
      background: transparent;
      outline: none;
      font-size: 15.5px;
      color: #17181c;
      min-width: 0;
      font-family: inherit;
    }
    .clear-btn {
      flex: none;
      width: 28px;
      height: 28px;
      border: 0;
      border-radius: 50%;
      background: #d3d8e0;
      color: #fff;
      font-size: 14px;
      cursor: pointer;
      font-family: inherit;
    }
    .filters-card {
      padding: 16px 4px 18px;
      margin-top: 12px;
    }
    .filter-title {
      font-size: 13px;
      font-weight: 700;
      color: #8a8f99;
      padding: 0 16px 8px;
    }
    .dist-title {
      padding-top: 4px;
    }
    .chip-row {
      display: flex;
      gap: 6px;
      overflow-x: auto;
      padding: 0 16px 12px;
      -webkit-overflow-scrolling: touch;
    }
    .chip-row:last-child {
      padding-bottom: 0;
    }
    .chip-row :global(.chip-btn) {
      flex: none;
      min-height: 44px;
      padding: 0 15px;
      border: 0;
      border-radius: 12px;
      font-size: 14px;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      white-space: nowrap;
      background: #f2f4f7;
      color: #5b5f68;
    }
    .chip-row :global(.chip-btn.active) {
      background: #17181c;
      color: #fff;
    }
    .result-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 2px 6px;
      margin-top: 2px;
    }
    .result-row span {
      font-size: 14px;
      color: #6b6f78;
    }
    .result-row button {
      border: 0;
      background: transparent;
      font-family: inherit;
      font-size: 14px;
      font-weight: 600;
      color: #2e63f6;
      cursor: pointer;
      min-height: 44px;
      padding: 0 4px;
    }
    .empty-state {
      padding: 48px 20px;
      text-align: center;
      margin-top: 4px;
    }
    .empty-title {
      font-size: 15.5px;
      font-weight: 700;
      margin-bottom: 4px;
    }
    .empty-sub {
      font-size: 14px;
      color: #8a8f99;
    }
    .year-groups {
      display: flex;
      flex-direction: column;
      gap: 20px;
      margin-top: 2px;
    }
    .year-groups :global(.year-head) {
      position: sticky;
      top: 0;
      z-index: 2;
      background: #f3f5f8;
      padding: 4px 6px 8px;
      display: flex;
      align-items: baseline;
      gap: 8px;
    }
    .year-groups :global(.year-head b) {
      font-size: 17px;
      font-weight: 800;
      letter-spacing: -0.02em;
    }
    .year-groups :global(.year-head span) {
      font-size: 13px;
      color: #9ba0aa;
    }
    .year-groups :global(.year-card-list) {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .year-groups :global(.meet-card) {
      background: #fff;
      border-radius: 18px;
      padding: 16px;
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: inherit;
    }
    .year-groups :global(.meet-card:hover) {
      background: #fbfcfd;
    }
    .year-groups :global(.meet-body) {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 7px;
    }
    .year-groups :global(.badge-row) {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
    }
    .year-groups :global(.kind-badge),
    .year-groups :global(.national-badge) {
      font-size: 11.5px;
      font-weight: 700;
      border-radius: 7px;
      padding: 3px 7px;
    }
    .year-groups :global(.national-badge) {
      color: #0e7a5f;
      background: #e1f5ee;
    }
    .year-groups :global(.meet-title) {
      font-size: 16px;
      font-weight: 700;
      letter-spacing: -0.01em;
      line-height: 1.4;
    }
    .year-groups :global(.meta-text) {
      font-size: 13px;
      color: #8a8f99;
      line-height: 1.5;
    }
    .year-groups :global(.dist-row) {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
      margin-top: 1px;
    }
    .year-groups :global(.dist-chip) {
      font-size: 12px;
      color: #5b5f68;
      background: #f2f4f7;
      border-radius: 999px;
      padding: 3px 9px;
    }
    .year-groups :global(.arrow) {
      flex: none;
      color: #c6cbd4;
      font-size: 20px;
    }
    .legacy-footer {
      padding: 8px 6px 0;
      font-size: 13px;
      color: #9ba0aa;
    }
  </style>
</Base>
