---
import { toAbsoluteUrl, withBase } from "../lib/base";

interface Props {
  title: string;
  description: string;
  robots?: string;
  canonical?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogType?: string;
  generatedAt?: string;
  /** 뒤로가기 링크. 헤더 내비게이션으로 갈 수 없는 상세 페이지에서만 쓴다. */
  back?: { href: string; label: string };
}

const { title, description, robots, canonical, ogTitle, ogDescription, ogImage, ogType, generatedAt, back } = Astro.props;

const canonicalUrl = canonical ? toAbsoluteUrl(canonical) : Astro.url?.toString() ?? toAbsoluteUrl();
const resolvedOgTitle = ogTitle ?? title;
const resolvedOgDescription = ogDescription ?? description;
const resolvedOgImage = toAbsoluteUrl(ogImage ?? "og-default.png");
const resolvedOgType = ogType ?? "website";
const currentPath = Astro.url?.pathname ?? withBase();
const basePath = withBase();

function normalizePath(path: string): string {
  const cleaned = String(path || "/").replace(/\/+$/, "");
  return cleaned.length === 0 ? "/" : `${cleaned}/`;
}

function isNavActive(href: string): boolean {
  const target = normalizePath(href);
  const current = normalizePath(currentPath);
  if (target === normalizePath(basePath)) return current === target;
  return current.startsWith(target);
}

const navItems = [
  { href: withBase(), label: "기록 조회" },
  { href: withBase("analysis/"), label: "분석" },
  { href: withBase("athlete/"), label: "선수" },
  { href: withBase("meet/"), label: "대회" },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={resolvedOgDescription} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={resolvedOgType} />
    <meta property="og:site_name" content="스플릿" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={withBase("favicon.ico")} sizes="32x32" />
    <link rel="icon" href={withBase("favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase("apple-touch-icon.png")} />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />

    <style is:global>
      /* ============================================================
         스플릿 — 디자인 토큰
         값은 reference/brand.md 및 CLAUDE.md 기준. 페이지에서 하드코딩 금지.
         ============================================================ */
      :root {
        /* 면 */
        --bg: #f3f5f8;
        --surface: #ffffff;
        --surface-2: #fafbfc;
        --surface-3: #f5f7fa;
        --fill: #f2f4f7;
        --line: #f0f2f5;
        --line-strong: #e3e7ed;

        /* 글자 */
        --ink: #17181c;
        --text: #3a3d45;
        --sub: #5b5f68;
        --sub-2: #6b6f78;
        --soft: #6f7683;
        --faint: #68707d;
        --faint-2: #808896;

        /* 포인트 — 하나뿐 */
        --point: #2e63f6;
        --point-hover: #1b47c4;
        --point-bg: #e9f0ff;
        --point-bg-2: #e4ebff;
        --point-2: #6d95f9;
        --point-3: #a9c3fa;
        --point-4: #cfdcfc;
        --danger: #c2453b;

        /* 모양 */
        --r-card: 20px;
        --r-inner: 16px;
        --r-ctl: 12px;
        --r-badge: 8px;
        --r-pill: 999px;

        /* 폭·간격 */
        --w: 560px;
        --gutter: 16px;
        --gap-card: 12px;
        --gap-section: 20px;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family:
          "Pretendard Variable",
          Pretendard,
          -apple-system,
          BlinkMacSystemFont,
          "Apple SD Gothic Neo",
          sans-serif;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
        text-wrap: pretty;
      }

      a {
        color: var(--point);
        text-decoration: none;
      }
      a:hover {
        color: var(--point-hover);
      }

      input,
      button,
      select,
      textarea {
        font-family: inherit;
      }
      :where(a, button, input, select, textarea, summary):focus-visible {
        outline: 3px solid var(--point);
        outline-offset: 2px;
      }
      :where(a, button, input, select, textarea, summary):focus:not(:focus-visible) {
        outline: none;
      }

      /* ---------- 헤더 ---------- */
      .site-header {
        position: sticky;
        top: 0;
        z-index: 20;
        background: rgb(243 245 248 / 94%);
        backdrop-filter: blur(6px);
        border-bottom: 1px solid var(--line);
      }
      .site-header-inner {
        max-width: var(--w);
        margin: 0 auto;
        padding: 10px var(--gutter);
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
      }
      .site-brand {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        color: var(--ink);
      }
      .site-brand:hover {
        color: var(--ink);
      }
      .site-brand-wordmark {
        font-size: 23px;
        font-weight: 900;
        letter-spacing: -0.055em;
        line-height: 1;
      }
      .site-nav {
        display: flex;
        align-items: center;
        gap: 3px;
        max-width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
      }
      .site-nav::-webkit-scrollbar {
        display: none;
      }
      .site-nav-link {
        min-height: 44px;
        border-radius: var(--r-ctl);
        padding: 0 10px;
        font-size: 13.5px;
        font-weight: 700;
        color: var(--sub);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        white-space: nowrap;
      }
      .site-nav-link:hover {
        color: var(--ink);
        background: var(--fill);
      }
      .site-nav-link.is-active,
      .site-nav-link.is-active:hover {
        color: #fff;
        background: var(--ink);
      }

      /* ---------- 페이지 골격 ---------- */
      .page {
        max-width: var(--w);
        margin: 0 auto;
        padding: 6px var(--gutter) 72px;
        display: flex;
        flex-direction: column;
        gap: var(--gap-card);
      }
      .back-link {
        align-self: flex-start;
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        margin-top: 6px;
        font-size: 14px;
        font-weight: 600;
        color: var(--sub-2);
      }
      .back-link:hover {
        color: var(--ink);
      }

      /* 페이지 머리 — 회색 배경 위, 카드 밖 */
      .page-head {
        padding: 16px 4px 2px;
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .page-head.is-tight {
        padding-top: 6px;
      }
      .page-head h1 {
        margin: 0;
        font-size: 29px;
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1.34;
      }
      .page-head .lead {
        margin: 0;
        font-size: 16px;
        color: var(--sub);
      }
      .page-head .lead b {
        color: var(--ink);
        font-weight: 700;
      }
      .eyebrow {
        align-self: flex-start;
        background: var(--point-bg-2);
        color: var(--point);
        font-size: 12px;
        font-weight: 700;
        padding: 6px 11px;
        border-radius: var(--r-pill);
        white-space: nowrap;
      }

      /* ---------- 카드 ---------- */
      .card {
        background: var(--surface);
        border-radius: var(--r-card);
        padding: 22px 20px;
      }
      .card.is-flush {
        padding: 16px;
      }
      .card-head {
        display: flex;
        flex-direction: column;
        gap: 4px;
        margin-bottom: 14px;
      }
      .card-head h2 {
        margin: 0;
        font-size: 19px;
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: 1.4;
      }
      .card-head p {
        margin: 0;
        font-size: 16px;
        color: var(--sub-2);
      }
      .card-head p b {
        color: var(--ink);
        font-weight: 700;
      }
      .tile {
        background: var(--surface-2);
        border-radius: var(--r-inner);
        padding: 14px;
      }
      .hint {
        margin: 14px 0 0;
        font-size: 13px;
        color: var(--faint);
      }
      .note-box {
        margin-top: 14px;
        background: var(--surface-3);
        border-radius: var(--r-inner);
        padding: 14px 16px;
        font-size: 16px;
        color: var(--sub-2);
      }

      /* ---------- 숫자 카드 ---------- */
      .metric-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px;
      }
      .metric-grid.is-4,
      .metric-grid.is-2 {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .metric {
        background: var(--surface-3);
        border-radius: 14px;
        padding: 13px 13px 12px;
        min-width: 0;
      }
      .metric.is-point {
        background: var(--point-bg);
      }
      .metric b {
        display: block;
        font-size: 21px;
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: 1.25;
        font-variant-numeric: tabular-nums;
      }
      .metric span {
        display: block;
        margin-top: 1px;
        font-size: 12.5px;
        color: var(--soft);
      }

      /* ---------- 칩 / 버튼 / 배지 ---------- */
      .chip-row {
        display: flex;
        gap: 6px;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
      }
      .chip-row::-webkit-scrollbar {
        display: none;
      }
      .chip-row.is-wrap {
        flex-wrap: wrap;
        overflow-x: visible;
      }
      .chip {
        flex: none;
        min-height: 44px;
        padding: 0 15px;
        border: 0;
        border-radius: var(--r-ctl);
        background: var(--fill);
        color: var(--sub);
        font-size: 14px;
        font-weight: 600;
        line-height: 1;
        white-space: nowrap;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
      }
      .chip:hover {
        color: var(--ink);
      }
      .chip.is-active,
      .chip.is-active:hover {
        background: var(--ink);
        color: #fff;
      }
      .btn {
        min-height: 48px;
        padding: 0 18px;
        border: 0;
        border-radius: 14px;
        background: var(--ink);
        color: #fff;
        font-size: 15px;
        font-weight: 700;
        line-height: 1;
        white-space: nowrap;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }
      .btn.is-ghost {
        background: var(--fill);
        color: var(--sub);
        min-height: 44px;
        font-size: 14px;
        font-weight: 600;
      }
      .badge {
        flex: none;
        font-size: 11.5px;
        font-weight: 700;
        line-height: 1.3;
        border-radius: var(--r-badge);
        padding: 4px 8px;
        white-space: nowrap;
        color: var(--text);
        background: var(--fill);
      }
      .badge.is-point {
        color: var(--point);
        background: var(--point-bg);
      }
      .badge.is-mute {
        color: var(--faint);
      }
      .badge-row {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
      }
      .rank-badge {
        flex: none;
        min-width: 48px;
        text-align: center;
        font-size: 14px;
        font-weight: 700;
        border-radius: 10px;
        padding: 5px 10px;
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
        background: var(--fill);
        color: var(--sub);
      }
      .rank-badge.is-gold {
        background: var(--point);
        color: #fff;
      }
      .rank-badge.is-podium {
        background: var(--point-bg);
        color: var(--point);
      }
      .rank-badge.is-mute {
        background: var(--fill);
        color: var(--faint);
      }

      /* ---------- 입력 ---------- */
      .field {
        display: flex;
        align-items: center;
        gap: 8px;
        min-height: 52px;
        padding: 0 14px;
        border-radius: 14px;
        border: 1.5px solid var(--line-strong);
        background: var(--surface);
      }
      .field.is-fill {
        border-color: transparent;
        background: var(--fill);
      }
      .field input {
        flex: 1;
        min-width: 0;
        border: 0;
        background: transparent;
        font-size: 16px;
        font-weight: 600;
        color: var(--ink);
      }
      .field:focus-within {
        border-color: var(--point);
        box-shadow: 0 0 0 3px rgb(46 99 246 / 22%);
      }
      .field .unit {
        flex: none;
        font-size: 13px;
        color: var(--faint-2);
      }
      .field-icon {
        flex: none;
        width: 16px;
        height: 16px;
        color: var(--soft);
        display: inline-flex;
      }
      .field-icon svg {
        width: 16px;
        height: 16px;
        fill: none;
        stroke: currentcolor;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
      }
      .field-clear {
        flex: none;
        min-width: 44px;
        min-height: 44px;
        border: 0;
        border-radius: 12px;
        background: #d3d8e0;
        color: #fff;
        font-size: 15px;
        line-height: 1;
        cursor: pointer;
      }
      .error-text {
        margin-top: 10px;
        font-size: 13.5px;
        color: var(--danger);
      }

      /* ---------- 막대 ---------- */
      .bar-track {
        position: relative;
        flex: 1;
        height: 20px;
        border-radius: 7px;
        background: var(--fill);
        overflow: hidden;
      }
      .bar-fill {
        position: absolute;
        left: 0;
        top: 0;
        height: 100%;
        border-radius: 7px;
        background: var(--point-3);
      }

      /* ---------- 리스트 공통 ---------- */
      .list {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }
      .list.is-divided {
        gap: 0;
      }
      .list.is-divided > * + * {
        border-top: 1px solid var(--line);
      }
      .row-link {
        display: block;
        color: inherit;
        background: var(--surface-2);
        border-radius: var(--r-inner);
        padding: 14px;
      }
      .row-link:hover {
        color: inherit;
        background: var(--surface-3);
      }

      /* ---------- 묻고 답하기 ---------- */
      .qa-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .qa {
        background: var(--surface-2);
        border-radius: var(--r-inner);
        padding: 16px;
      }
      .qa-q {
        font-size: 15px;
        font-weight: 700;
        margin-bottom: 5px;
      }
      .qa-a {
        font-size: 16px;
        color: var(--sub);
      }

      /* ---------- 그룹 헤더 (sticky) ---------- */
      .group-head {
        position: sticky;
        top: 54px;
        z-index: 2;
        background: var(--bg);
        padding: 4px 6px 8px;
        display: flex;
        align-items: baseline;
        gap: 8px;
      }
      .group-head b {
        font-size: 17px;
        font-weight: 800;
        letter-spacing: -0.02em;
        font-variant-numeric: tabular-nums;
      }
      .group-head span {
        font-size: 13px;
        color: var(--faint);
      }

      /* ---------- 빈 상태 ---------- */
      .empty {
        text-align: center;
        padding: 48px 20px;
      }
      .empty b {
        display: block;
        font-size: 15.5px;
        font-weight: 700;
        margin-bottom: 4px;
      }
      .empty span {
        font-size: 14px;
        color: var(--soft);
      }

      /* ---------- 푸터 ---------- */
      .site-footer {
        margin-top: 8px;
        padding: 16px;
        border-radius: var(--r-inner);
        background: var(--surface-3);
        color: var(--soft);
        font-size: 13px;
        line-height: 1.6;
      }
      .site-footer a {
        font-weight: 700;
      }

      /* ============================================================
         분포 도구 (DistributionTool) — 클래스는 컴포넌트와 공유
         ============================================================ */
      .dist-tool {
        display: flex;
        flex-direction: column;
        gap: var(--gap-card);
      }
      .dist-top-link {
        display: none;
      }
      .dist-hero {
        padding: 16px 4px 2px;
      }
      .dist-hero h1 {
        margin: 0;
        font-size: 29px;
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1.34;
      }
      .dist-hero p {
        margin: 10px 0 0;
        font-size: 15px;
        color: var(--sub);
      }
      .dist-card {
        background: var(--surface);
        border-radius: var(--r-card);
        padding: 22px 20px;
        display: flex;
        flex-direction: column;
        gap: 20px;
      }
      .dist-card h2 {
        margin: 0;
        font-size: 19px;
        font-weight: 800;
        letter-spacing: -0.02em;
      }
      .dist-stage-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 10px;
      }
      .dist-stage-title b {
        font-size: 16px;
        font-weight: 700;
        color: var(--ink);
      }
      .dist-stage-badge {
        flex: none;
        font-size: 11.5px;
        font-weight: 700;
        color: var(--point);
        background: var(--point-bg);
        border-radius: var(--r-badge);
        padding: 4px 8px;
        line-height: 1.3;
        white-space: nowrap;
      }
      .dist-seg-wrap {
        display: flex;
        gap: 4px;
        background: var(--fill);
        border-radius: 14px;
        padding: 4px;
        margin-bottom: 10px;
      }
      .dist-seg-button {
        flex: 1;
        min-height: 44px;
        border: 0;
        border-radius: 11px;
        background: transparent;
        color: var(--soft);
        font-size: 14.5px;
        font-weight: 700;
        line-height: 1.2;
        cursor: pointer;
        white-space: nowrap;
      }
      .dist-seg-button.is-active {
        background: var(--surface);
        color: var(--ink);
        box-shadow: 0 1px 3px rgb(23 24 28 / 10%);
      }
      .dist-scope-card {
        gap: 12px;
      }
      .dist-scope-note {
        margin: 0;
        font-size: 14px;
        color: var(--sub);
        background: var(--surface-3);
        border-radius: var(--r-ctl);
        padding: 12px 13px;
      }
      .dist-chip-row {
        display: flex;
        gap: 6px;
        overflow-x: auto;
        padding-bottom: 4px;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
      }
      .dist-chip-row::-webkit-scrollbar {
        display: none;
      }
      .dist-chip-row-wrap {
        flex-wrap: wrap;
        overflow-x: visible;
      }
      .dist-chip {
        flex: none;
        min-height: 44px;
        padding: 0 15px;
        border: 0;
        border-radius: var(--r-ctl);
        background: var(--fill);
        color: var(--sub);
        font-size: 14px;
        font-weight: 600;
        line-height: 1;
        cursor: pointer;
        white-space: nowrap;
      }
      .dist-chip.is-active {
        background: var(--ink);
        color: #fff;
      }
      .dist-field-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 6px;
      }
      .dist-text-button {
        flex: none;
        border: 0;
        background: transparent;
        padding: 0 2px;
        min-height: 40px;
        font-size: 13.5px;
        font-weight: 700;
        color: var(--point);
        cursor: pointer;
        white-space: nowrap;
      }
      .dist-text-button:hover {
        color: var(--point-hover);
      }
      .dist-field-head .dist-group-label {
        margin-bottom: 0;
      }
      .dist-group-label-spaced {
        margin-top: 16px;
      }
      .dist-year-select {
        display: grid;
        gap: 6px;
      }
      .dist-year-select input {
        width: 100%;
        min-height: 52px;
        border-radius: var(--r-ctl);
        border: 1.5px solid var(--line-strong);
        background: var(--surface);
        padding: 0 14px;
        font-size: 16px;
        font-weight: 600;
        color: var(--ink);
        font-variant-numeric: tabular-nums;
      }
      .dist-age-mode-note,
      .dist-year-merged-note {
        margin: 10px 0 0;
        font-size: 13px;
        color: var(--soft);
      }
      .dist-distance-fallback-note {
        margin: 10px 0 0;
        font-size: 13px;
        color: var(--sub-2);
        background: var(--surface-3);
        border-radius: 11px;
        padding: 10px 12px;
      }
      .dist-step-divider {
        border-top: 1px solid var(--line);
        padding-top: 18px;
      }
      .dist-input-guide {
        margin: 10px 0 0;
        font-size: 15px;
        color: var(--soft);
      }
      .dist-input-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 8px;
      }
      .dist-input-box {
        min-width: 0;
        display: flex;
        align-items: center;
        gap: 8px;
        min-height: 52px;
        padding: 0 14px;
        border-radius: 14px;
        border: 1.5px solid var(--line-strong);
        background: var(--surface);
      }
      .dist-input-box input {
        flex: 1;
        min-width: 0;
        border: 0;
        background: transparent;
        font-size: 16px;
        font-weight: 600;
        color: var(--ink);
      }
      .dist-input-box:focus-within {
        border-color: var(--point);
        box-shadow: 0 0 0 3px rgb(46 99 246 / 22%);
      }
      .dist-input-box span {
        flex: none;
        font-size: 13px;
        color: var(--faint-2);
      }
      .dist-clear-button {
        min-width: 64px;
        min-height: 52px;
        padding: 0 16px;
        border: 0;
        border-radius: 14px;
        background: var(--fill);
        color: var(--sub);
        font-size: 14px;
        font-weight: 600;
        line-height: 1;
        cursor: pointer;
        white-space: nowrap;
      }
      .dist-error-text {
        margin-top: 10px;
        font-size: 13.5px;
        color: var(--danger);
      }
      .dist-stepper {
        margin-top: 8px;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        gap: 8px;
        align-items: stretch;
      }
      .dist-stepper-button {
        min-height: 52px;
        padding: 0 14px;
        border: 0;
        border-radius: 14px;
        background: var(--fill);
        color: var(--sub);
        font-size: 13.5px;
        font-weight: 700;
        white-space: nowrap;
        cursor: pointer;
      }
      .dist-stepper-value {
        min-width: 0;
        min-height: 52px;
        border: 1.5px solid var(--line-strong);
        border-radius: 14px;
        background: var(--surface);
        padding: 0 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        font-weight: 700;
        color: var(--ink);
        font-variant-numeric: tabular-nums;
        text-align: center;
      }
      .dist-manual-input {
        margin-top: 10px;
        border-top: 1px solid var(--line);
        padding-top: 10px;
      }
      .dist-manual-input-summary {
        list-style: none;
        cursor: pointer;
        min-height: 40px;
        display: inline-flex;
        align-items: center;
        font-size: 14px;
        font-weight: 700;
        color: var(--text);
      }
      .dist-manual-input-summary::-webkit-details-marker {
        display: none;
      }
      .dist-manual-input-summary::after {
        content: "▾";
        margin-left: 6px;
        font-size: 12px;
        color: var(--soft);
      }
      .dist-manual-input[open] .dist-manual-input-summary::after {
        content: "▴";
      }
      .dist-group-label {
        margin-bottom: 6px;
        font-size: 13px;
        color: var(--soft);
      }
      .dist-verdict {
        font-size: 25px;
        font-weight: 800;
        letter-spacing: -0.025em;
        color: var(--point);
        line-height: 1.32;
      }
      .dist-verdict-detail {
        margin-top: 6px;
        font-size: 16px;
        color: var(--sub);
      }
      .dist-fallback-note {
        margin: 0 0 10px;
        font-size: 13px;
        color: var(--sub);
        background: var(--surface-3);
        border-radius: var(--r-ctl);
        padding: 10px 12px;
      }
      .dist-range-note {
        margin-top: 12px;
        font-size: 13.5px;
        color: var(--sub-2);
        background: var(--surface-3);
        border-radius: var(--r-ctl);
        padding: 11px 12px;
      }
      .dist-evidence {
        margin-top: 16px;
        border-top: 1px solid var(--line);
        padding-top: 12px;
      }
      .dist-evidence-summary {
        list-style: none;
        cursor: pointer;
        font-size: 14px;
        font-weight: 700;
        color: var(--text);
        min-height: 36px;
        display: flex;
        align-items: center;
      }
      .dist-evidence-summary::-webkit-details-marker {
        display: none;
      }
      .dist-evidence-summary::after {
        content: "▾";
        margin-left: 6px;
        font-size: 12px;
        color: var(--soft);
      }
      .dist-evidence[open] .dist-evidence-summary::after {
        content: "▴";
      }
      .dist-evidence-inner {
        margin-top: 4px;
      }
      .dist-band-wrap {
        background: var(--surface-2);
        border-radius: 18px;
        padding: 18px 16px 16px;
      }
      .dist-band-labels {
        display: flex;
        justify-content: space-between;
        margin-bottom: 9px;
        font-size: 12.5px;
        font-weight: 700;
        color: var(--soft);
      }
      .dist-band-marker-wrap {
        position: relative;
        padding-top: 26px;
      }
      .dist-band {
        display: flex;
        height: 32px;
        border-radius: 10px;
        overflow: hidden;
      }
      .dist-band > div {
        flex: 1;
      }
      .dist-band > div:nth-child(1) {
        background: var(--point);
      }
      .dist-band > div:nth-child(2) {
        background: var(--point-2);
      }
      .dist-band > div:nth-child(3) {
        background: var(--point-3);
      }
      .dist-band > div:nth-child(4) {
        background: var(--point-4);
      }
      .dist-marker {
        position: absolute;
        top: 0;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .dist-marker-tag {
        background: var(--ink);
        color: #fff;
        font-size: 12px;
        font-weight: 700;
        border-radius: var(--r-badge);
        padding: 4px 8px;
        white-space: nowrap;
        line-height: 1.2;
      }
      .dist-marker-line {
        width: 2px;
        height: 8px;
        background: var(--ink);
        margin: 0 auto;
      }
      .dist-edge-labels {
        display: flex;
        margin-top: 7px;
      }
      .dist-edge-labels span {
        flex: 1;
        font-size: 11.5px;
        color: var(--soft);
        font-variant-numeric: tabular-nums;
        text-align: center;
      }
      .dist-edge-labels span:first-child {
        text-align: left;
      }
      .dist-edge-labels span:last-child {
        text-align: right;
      }
      .dist-reading-guide {
        margin-top: 14px;
        border-top: 1px solid var(--line);
        padding-top: 12px;
        font-size: 13.5px;
        color: var(--sub-2);
      }
      .dist-quantile-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 12px;
        font-size: 13px;
      }
      .dist-quantile-table th,
      .dist-quantile-table td {
        padding: 9px 0;
        border-bottom: 1px solid var(--line);
        text-align: left;
        font-variant-numeric: tabular-nums;
      }
      .dist-quantile-table th {
        color: var(--sub-2);
        font-weight: 600;
      }
      .dist-quantile-table td {
        color: var(--ink);
        font-weight: 700;
      }
      .dist-caution-box {
        margin-top: 14px;
        background: var(--surface-3);
        border-radius: var(--r-inner);
        padding: 15px 16px;
      }
      .dist-caution-title {
        font-size: 15px;
        font-weight: 700;
        color: var(--ink);
        margin-bottom: 4px;
      }
      .dist-caution-body {
        font-size: 16px;
        color: var(--sub-2);
      }
      .dist-thin-card {
        text-align: center;
        padding: 36px 22px 30px;
      }
      .dist-thin-title {
        font-size: 17px;
        font-weight: 800;
        letter-spacing: -0.02em;
        margin-bottom: 8px;
      }
      .dist-thin-body {
        margin: 0 auto;
        max-width: 340px;
        font-size: 14.5px;
        color: var(--sub-2);
      }
      .dist-thin-actions {
        margin-top: 20px;
        display: flex;
        flex-direction: column;
        gap: 8px;
      }
      .dist-thin-actions button {
        min-height: 48px;
        border: 0;
        border-radius: 14px;
        background: var(--ink);
        color: #fff;
        font-size: 15px;
        font-weight: 700;
        line-height: 1;
        cursor: pointer;
      }
      .dist-notes-intro {
        margin: 0 0 16px;
        font-size: 16px;
        color: var(--sub-2);
      }
      .dist-notes-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .dist-note-item {
        background: var(--surface-2);
        border-radius: var(--r-inner);
        padding: 16px;
      }
      .dist-note-q {
        margin-bottom: 5px;
        font-size: 15px;
        font-weight: 700;
        color: var(--ink);
      }
      .dist-note-a {
        font-size: 16px;
        color: var(--sub);
      }

      /* ---------- 좁은 화면 ---------- */
      @media (max-width: 640px) {
        :root {
          --gutter: 14px;
        }
        .site-header-inner {
          padding: 8px 14px;
        }
        .site-nav {
          width: 100%;
          padding-bottom: 2px;
        }
        .site-brand {
          gap: 7px;
        }
        .site-brand-wordmark {
          font-size: 21px;
        }
        .site-nav-link {
          padding: 0 9px;
          font-size: 13px;
        }
        .page-head h1,
        .dist-hero h1 {
          font-size: 26px;
        }
        .card {
          padding: 20px 16px;
        }
        .dist-card {
          padding: 20px 16px;
        }
        .dist-input-row,
        .dist-stepper {
          grid-template-columns: 1fr;
        }
        .dist-clear-button,
        .dist-stepper-button {
          width: 100%;
        }
        .metric-grid {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
        .metric b {
          font-size: 19px;
        }
        /* 5칸 눈금은 360px에서 값이 겹친다. 양 끝과 한가운데만 남긴다. */
        .dist-edge-labels span:nth-child(2),
        .dist-edge-labels span:nth-child(4) {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="site-brand" href={withBase()} aria-label="스플릿 홈">
          <svg width="26" height="26" viewBox="0 0 64 64" role="img" aria-hidden="true">
            <rect width="27" height="64" rx="5" fill="#2E63F6"></rect>
            <rect x="35" width="29" height="64" rx="5" fill="#17181C"></rect>
          </svg>
          <span class="site-brand-wordmark">스플릿</span>
        </a>
        <nav class="site-nav" aria-label="주요 메뉴">
          {
            navItems.map((item) => (
              <a class={`site-nav-link ${isNavActive(item.href) ? "is-active" : ""}`} href={item.href}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <main class="page">
      {back && <a class="back-link" href={back.href}>← {back.label}</a>}
      <slot />
      <footer class="site-footer">
        공개된 경기 기록을 개인이 정리한 페이지입니다. 대한빙상경기연맹 및 대한체육회와 무관합니다.<br />
        출처: 대한체육회 경기결과 시스템(result.sports.or.kr)<br />
        <a href={withBase("privacy/")}>개인정보 처리방침</a>
        ·
        <a href={withBase("privacy/#request")}>삭제/처리정지 요청</a><br />
        마지막 갱신일: {generatedAt ?? "-"}
      </footer>
    </main>
  </body>
</html>
